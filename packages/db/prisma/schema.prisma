  grade                  Grade                   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  academicYear           AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classTeacher           Teacher?                @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students               Student[]
  timetableSlots         TimetableSlot[]
  announcements          Announcement[]
  classNotes             ClassNote[]
  classTodos             ClassTodo[]
  registerChangeRequests RegisterChangeRequest[]
  notificationOutbox     NotificationOutbox[]
  assignments            Assignment[]
  messageThreads         MessageThread[]
  diaryEntries           DiaryEntry[]

  @@unique([schoolId, gradeId, name, academicYearId])
  @@index([schoolId])
}

model Subject {
  id              String           @id @default(uuid()) @db.Uuid
  schoolId        String           @db.Uuid
  name            String
  code            String
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]
  timetableSlots  TimetableSlot[]
  classNotes      ClassNote[]
  classTodos      ClassTodo[]
  assignments     Assignment[]
  messageThreads  MessageThread[]
  diaryEntries    DiaryEntry[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Teacher {
  id               String           @id @default(uuid()) @db.Uuid
  schoolId         String           @db.Uuid
  userId           String?          @db.Uuid
  firstName        String
  lastName         String
  email            String?
  phone            String?
  photoAssetId     String?          @db.Uuid
  primarySubjectId String?          @db.Uuid
  bio              String?
  isActive         Boolean          @default(true)
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects  TeacherSubject[]
  classSections    ClassSection[]   @relation("ClassTeacher")
  timetableSlots   TimetableSlot[]
  featuredIn       FeaturedStaff[]
  messageThreads   MessageThread[]
  libraryIssues    LibraryIssue[]

  @@index([schoolId])
}

model TeacherSubject {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @db.Uuid
  teacherId String  @db.Uuid
  subjectId String  @db.Uuid
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([schoolId])
}

model Student {
  id                String             @id @default(uuid()) @db.Uuid
  schoolId          String             @db.Uuid
  admissionNo       String
  /// The human-friendly student code, e.g. RAF-00042 ({School.codePrefix} +
  /// zero-padded per-school counter). Allocated when the login is created
  /// (Phase 5·1); doubles as the login identifier and the add-a-child key.
  code              String?
  firstName         String
  lastName          String
  email             String?
  classSectionId    String?            @db.Uuid
  rollNo            String?
  dob               DateTime?
  gender            String?
  guardianName      String?
  guardianPhone     String?
  photoAssetId      String?            @db.Uuid
  userId            String?            @unique @db.Uuid
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection      ClassSection?      @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  attendance        Attendance[]
  results           Result[]
  assignmentsSeen   AssignmentSeen[]
  messageThreads    MessageThread[]
  diaryReceipts     DiaryRecipient[]
  diaryAcks         DiaryAck[]
  attendanceNotices AttendanceNotice[]
  libraryIssues     LibraryIssue[]

  @@unique([schoolId, admissionNo])
  @@unique([schoolId, code])
  @@index([schoolId, classSectionId])
}

model Period {
  id             String          @id @default(uuid()) @db.Uuid
  schoolId       String          @db.Uuid
  order          Int
  label          String
  startTime      String
  endTime        String
  kind           PeriodKind      @default(CLASS)
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]

  @@unique([schoolId, order])
  @@index([schoolId])
}

model TimetableSlot {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @db.Uuid
  classSectionId String       @db.Uuid
  dayOfWeek      Int
  periodId       String       @db.Uuid
  subjectId      String       @db.Uuid
  teacherId      String       @db.Uuid
  academicYearId String       @db.Uuid
  effectiveFrom  DateTime     @default(now())
  effectiveTo    DateTime?
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  period         Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classSectionId, dayOfWeek, periodId, academicYearId, effectiveFrom], name: "class_slot")
  @@unique([schoolId, teacherId, dayOfWeek, periodId, academicYearId, effectiveFrom], name: "teacher_slot")
  @@index([schoolId])
  @@index([schoolId, classSectionId, effectiveFrom])
  @@index([schoolId, teacherId, effectiveFrom])
  @@index([schoolId, subjectId])
  @@index([schoolId, academicYearId])
}

// ── Academics: attendance, exams, results ────────────────
model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  studentId      String           @db.Uuid
  classSectionId String           @db.Uuid
  date           DateTime         @db.Date
  status         AttendanceStatus
  markedById     String           @db.Uuid // Teacher.id
  createdAt      DateTime         @default(now())
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date], name: "one_mark_per_student_day")
  @@index([schoolId, classSectionId, date])
}

model Substitution {
  id                  String   @id @default(uuid()) @db.Uuid
  schoolId            String   @db.Uuid
  classSectionId      String   @db.Uuid
  periodId            String   @db.Uuid
  date                DateTime @db.Date
  originalTeacherId   String   @db.Uuid
  substituteTeacherId String?  @db.Uuid // null = uncovered gap
  reason              String? // e.g. "leave"
  createdAt           DateTime @default(now())
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, periodId, date], name: "one_sub_per_slot_date")
  @@index([schoolId, date])
}

model Staff {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String    @db.Uuid
  firstName    String
  lastName     String
  role         StaffRole @default(OTHER)
  email        String?
  phone        String?
  userId       String?   @db.Uuid
  /// Self-uploaded avatar (MediaAsset id, kind AVATAR) — bare scalar like
  /// Student.photoAssetId / Teacher.photoAssetId (Phase 5·0d).
  photoAssetId String?   @db.Uuid
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model StaffAttendance {
  id         String                 @id @default(uuid()) @db.Uuid
  schoolId   String                 @db.Uuid
  teacherId  String?                @db.Uuid
  staffId    String?                @db.Uuid
  date       DateTime               @db.Date
  status     PersonAttendanceStatus
  markedById String?                @db.Uuid
  createdAt  DateTime               @default(now())
  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date], name: "one_teacher_mark_per_day")
  @@unique([staffId, date], name: "one_staff_mark_per_day")
  @@index([schoolId, date])
}

model LeaveApplication {
  id           String        @id @default(uuid()) @db.Uuid
  schoolId     String        @db.Uuid
  teacherId    String        @db.Uuid
  type         LeaveType
  /// The school's own leave-type row this application counts against.
  /// Null on rows from before the policy feature (and on types the school
  /// never configured) — those resolve through `type` instead.
  typeDefId    String?       @db.Uuid
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  reason       String?
  status       LeaveStatus   @default(PENDING)
  reviewedById String?       @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  typeDef      LeaveTypeDef? @relation(fields: [typeDefId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([schoolId, teacherId])
  @@index([schoolId, typeDefId])
}

/// A school's own leave vocabulary — quota and carry-forward policy live
/// here. Seeded from the five built-in `LeaveType` values the first time the
/// school opens its policy, so existing applications map 1:1; a school can
/// add custom types beyond them. No RLS — `schoolId` filters are load-bearing,
/// same as LeaveApplication.
model LeaveTypeDef {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String             @db.Uuid
  name            String
  /// The built-in enum value this row mirrors — null for a custom type.
  builtin         LeaveType?
  isPaid          Boolean            @default(true)
  /// Days per year that "apply defaults to everyone" grants. 0 = the type
  /// exists but carries no standing quota (e.g. Unpaid).
  defaultAnnual   Int                @default(0)
  /// Max unused days that survive a year close into the next year. 0 = lapse.
  carryForwardCap Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allocations     LeaveAllocation[]
  applications    LeaveApplication[]

  @@unique([schoolId, name])
  @@unique([schoolId, builtin])
  @@index([schoolId])
}

/// One teacher's grant of one leave type for one academic year. `used` is
/// deliberately NOT a column — it is derived from APPROVED applications at
/// read time, so a cancelled leave refunds itself and the figures cannot
/// drift. `teacherId` is a plain uuid joined in JS, the Substitution pattern.
model LeaveAllocation {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @db.Uuid
  teacherId      String       @db.Uuid
  typeDefId      String       @db.Uuid
  academicYearId String       @db.Uuid
  allotted       Int          @default(0)
  /// Days carried in from the previous year's unused balance at year close.
  carriedIn      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  typeDef        LeaveTypeDef @relation(fields: [typeDefId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId, typeDefId, academicYearId])
  @@index([schoolId, academicYearId])
}

model Exam {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  classSectionId String   @db.Uuid
  subjectId      String   @db.Uuid
  title          String
  scheduledAt    DateTime
  syllabus       String?
  maxMarks       Int
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  results        Result[]

  @@index([schoolId, classSectionId, scheduledAt])
}

/// `schoolId` is carried DIRECTLY rather than derived through `examId ->
/// Exam.schoolId`, which is how this table's RLS policy used to establish
/// tenancy. Two reasons, both learned the hard way:
///
///  1. Consistency. Every other tenant table compares `schoolId` to
///     `app.current_tenant` directly; `Result` was one of two tables (with
///     `AssignmentSeen`) whose policy ran an `EXISTS` subquery against its
///     parent instead. One shape for 70 tables and a second shape for two is
///     exactly how an exemption survives a review nobody re-reads.
///  2. Indexability. Without a `schoolId` column the only index here was
///     `@@unique([examId, studentId])`, so "show me this child's results" —
///     the most common read a parent triggers — had no index it could use
///     (`studentId` never leads). `@@index([schoolId, studentId])` fixes that.
model Result {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @db.Uuid
  examId      String    @db.Uuid
  studentId   String    @db.Uuid
  marks       Float
  publishedAt DateTime?
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId], name: "one_result_per_exam_student")
  @@index([schoolId, studentId])
}

/// Transactional outbox for "families' phones get told" events (S6/S7 wiring,
/// Portal Parity R3 Phase 4 Task 2). `ExamsService.create()`/`publish()`
/// write one row here IN THE SAME `withTenant` transaction as the exam/result
/// write itself — so a result is never published without its notification
/// row existing, and a rolled-back transaction leaves no orphan row either.
/// A cron drain (`NotificationOutboxService`, `internal/cron/notification-outbox`)
/// reads unsent rows and sends push via the existing `PushChannel`, then sets
/// `sentAt`. `kind` is a plain String (not a Prisma enum) validated at write
/// time via `assertNotificationOutboxKind` (`@skoolos/types`) — matches the
/// String-kind pattern already used for `LeaveApplication.type`/`Holiday.type`
/// elsewhere in this schema.
///
/// `payload` is DENORMALISED at write time (exam title, subject/class name,
/// maxMarks/date already resolved to display strings) so the drain never
/// joins back to `Exam`/`Subject`/`ClassSection` — see
/// `ExamScheduledOutboxPayload`/`ResultPublishedOutboxPayload`
/// (apps/api/src/common/notifications/notification.types.ts).
model NotificationOutbox {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @db.Uuid
  kind           String
  payload        Json
  /// Null only for single-reader kinds that have no section to broadcast to
  /// (LIBRARY_NOTICE to a teacher). The drain reads it only when
  /// targetUserId is null, so a null section never reaches a resolver.
  classSectionId String?       @db.Uuid
  /// When set, the drain pushes to THIS single user only (a private message —
  /// MESSAGE_RECEIVED, or any LIBRARY_NOTICE), instead of resolving the whole
  /// classSectionId's section recipients. Null for the broadcast kinds
  /// (exam/result/assignment).
  targetUserId   String?       @db.Uuid
  createdAt      DateTime      @default(now())
  sentAt         DateTime?
  /// Incremented on every failed send attempt; the drain excludes rows at
  /// or above its MAX_ATTEMPTS cap rather than retrying forever.
  attempts       Int           @default(0)
  lastError      String?
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection   ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  /// The drain's own query shape: unsent rows, oldest first.
  @@index([schoolId, sentAt])
  @@index([schoolId, classSectionId])
  @@index([sentAt, createdAt])
}

/// A teacher-posted assignment for one class section (T21, Portal Parity R3
/// Phase 4 Task 4). `attachments` is a denormalised JSON array of
/// `{ url, name, kind }` (`kind`: `'pdf' | 'image'`), each uploaded via
/// `POST /manage/assignments/upload` — a THIN endpoint that delegates
/// straight to `StorageService` (the shared S3/MinIO client also used by
/// `MediaService`), NOT the CMS media service itself: `MediaService`/
/// `MediaAsset` are scoped to a fixed site-content `kind` taxonomy
/// (LOGO/HERO/GALLERY/…), image-only, and carry no `@Roles` guard at all —
/// wrong shape and wrong ACL for a teacher-facing PDF/image attachment (see
/// `AssignmentsController`'s docstring for the full reasoning).
///
/// v1 has NO submission uploads (a marking workflow, deliberately cut) —
/// tracking is per-class visibility plus `AssignmentSeen` "opened" marks
/// only.
///
/// `createdByTeacherId` stores the CALLER'S `User.id` — mirrors
/// `Exam.createdById` exactly, including its reasoning: this field is
/// ATTRIBUTION ONLY, never the authorization gate. Ownership for
/// create/list/delete is resolved entirely via `classSectionId` through
/// `assertClassOwned`/`AttendanceService.myClassSections`, the SAME rule
/// `ExamsService` uses (covering-only teachers excluded) — never a second,
/// creator-based check.
model Assignment {
  id                 String   @id @default(uuid()) @db.Uuid
  schoolId           String   @db.Uuid
  classSectionId     String   @db.Uuid
  subjectId          String   @db.Uuid
  title              String
  instructions       String
  dueDate            DateTime @db.Date
  attachments        Json     @default("[]")
  createdByTeacherId String   @db.Uuid
  createdAt          DateTime @default(now())

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  seen         AssignmentSeen[]

  @@index([schoolId, classSectionId, dueDate])
  @@index([schoolId, subjectId])
}

/// A student's "seen/opened" mark for an `Assignment` — v1's ONLY tracking
/// signal (see `Assignment`'s docstring: no submission uploads yet).
/// `AssignmentsService.markSeen` upserts on the unique pair below, so a
/// student re-opening the same assignment twice never creates a second row
/// — idempotent by construction, not by a pre-check.
///
/// Carries `schoolId` DIRECTLY, like every other tenant table. It used to
/// derive tenancy through `assignmentId -> Assignment.schoolId` — the same
/// second-class pattern `Result` used — and was converted alongside it for the
/// reasons written on `Result`.
model AssignmentSeen {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  assignmentId String   @db.Uuid
  studentId    String   @db.Uuid
  seenAt       DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId], name: "one_seen_per_assignment_student")
  @@index([schoolId, studentId])
}

// Messaging (Phase 4 Task 5 / item T17). A student asks one of the teachers who
// actually teaches them (a subject, from the timetable) a question; the teacher
// replies. One thread per (student, teacher, subject). `teacherId` is a
// Teacher.id (matching TimetableSlot.teacherId), `studentId` a Student.id — the
// authorization join is against the timetable, never client-supplied ids.
model MessageThread {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  studentId      String   @db.Uuid
  teacherId      String   @db.Uuid
  subjectId      String   @db.Uuid
  classSectionId String   @db.Uuid
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([studentId, teacherId, subjectId], name: "one_thread_per_student_teacher_subject")
  @@index([schoolId, teacherId, lastMessageAt])
  @@index([schoolId, studentId, lastMessageAt])
  @@index([schoolId, classSectionId])
}

model Message {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @db.Uuid
  threadId   String    @db.Uuid
  senderRole String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// In-app notification inbox — the per-user, per-event rows behind the bell in
/// both portals (unread count + notification list). DISTINCT from
/// `NotificationOutbox`, which is a fire-and-forget PUSH queue with no per-user
/// read state: a `Notification` row PERSISTS until its recipient reads it, and
/// `readAt` is what the bell's unread count decrements against.
///
/// Rows are written SYNCHRONOUSLY, inside the SAME `withTenant` transaction as
/// the domain event (a new message, a scheduled exam, a published result, a
/// posted assignment) via `emitNotifications`
/// (apps/api/src/common/notifications/notification-inbox.ts) — right beside the
/// matching `NotificationOutbox` write. That keeps in-app notifications
/// IMMEDIATE regardless of the outbox drain's cron cadence, and all-or-nothing
/// with the event itself.
///
/// `userId` is the RECIPIENT's `User.id` (student or teacher login), kept as a
/// bare scalar with NO Prisma relation / FK — the SAME choice as
/// `PushToken.userId`: a hard user delete simply orphans harmless unread rows,
/// and the `schoolId` cascade still clears them when a school is removed. `kind`
/// is a plain String validated by `assertNotificationKind` (@skoolos/types),
/// mirroring `NotificationOutbox.kind`. `linkType`/`linkId` are an optional
/// deep-link the client resolves to a route BY ROLE (e.g. linkType `thread` +
/// a threadId → the student's or teacher's own thread route).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @db.Uuid
  userId    String    @db.Uuid
  kind      String
  title     String
  body      String?
  linkType  String?
  linkId    String?
  readAt    DateTime?
  /// Soft clear ("dismiss"): a cleared row disappears from the caller's list
  /// and counts but is never destroyed — audit-friendly, and a mis-tap is
  /// recoverable by support. Every read path filters `clearedAt: null`.
  clearedAt DateTime?
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// unread count + unread list for one user (the bell's hot path)
  @@index([schoolId, userId, readAt])
  /// recent list, newest-first (the paginated notification screen)
  @@index([schoolId, userId, createdAt])
}

// ── Exam Hall ────────────────────────────────────────────
/// A physical room, described only as far as seating needs it: how many rows
/// of desks, how many desks in a row, and how many students share one desk.
///
/// Deliberately NOT exam-only. The office records its rooms once and the same
/// rows can feed anything later that needs a venue (timetable, events, PTM
/// desks), which is why this is `Room` and not `ExamRoom`.
///
/// `removedDesks` holds the grid positions with no desk — a pillar, a broken
/// desk, or a gap the school keeps as a walking lane. A string array of
/// "row:col" (both 0-based) rather than a child table: it is read and written
/// only as a whole, never queried across rooms, and one room's worth of
/// exceptions is a handful of strings.
model Room {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  name         String
  /// Rows of desks, front (nearest the board) to back.
  rows         Int      @default(6)
  /// Desks across one row, left to right as you face the board.
  cols         Int      @default(6)
  /// 1 or 2. Two only where the desk is a bench.
  seatsPerDesk Int      @default(1)
  /// "row:col" positions, 0-based, that hold no desk.
  removedDesks String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  seatingPlans SeatingPlan[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// One generated seating chart for one room. `seats` is the whole plan as
/// JSON, not a row per student.
///
/// A plan is written once by the generator and afterwards read whole — the
/// office prints it, it never queries inside it. A `Seat` table would be the
/// largest in this schema (a row per student per paper) to serve reads that
/// always want every row anyway. When "where does this child sit?" becomes a
/// real question from the parent portal, that is the moment to promote it.
model SeatingPlan {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  roomId          String   @db.Uuid
  /// What the office calls this sitting — "Half-Yearly, Day 3, Morning".
  title           String
  /// Sections this plan seats, in the order the office ticked them.
  classSectionIds String[] @default([])
  /// Which rules were on, so a reprint months later is still explainable.
  rules           Json
  /// The generator is seeded, so the same inputs rebuild the same hall.
  seed            Int
  /// PlannedSeat[] — row, seat index, student, class, roll.
  seats           Json
  /// The room's shape AT SAVE TIME — rows, cols, seatsPerDesk, removedDesks.
  ///
  /// Without this, reopening a plan draws its seats into whatever shape the
  /// room has TODAY. Narrow Hall A from nine desks to six after saving and the
  /// chart silently loses every seat past S06 while the door list still names
  /// them. The seats are already frozen here; the floor they sit on has to be
  /// frozen with them. Null on rows written before this column existed —
  /// `SeatingService.get` falls back to the live room for those.
  roomShape       Json?
  /// What the generator could and could not do, in the words the office read.
  report          Json
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([schoolId, roomId])
}

// ── Community ────────────────────────────────────────────
model Event {
  id               String              @id @default(uuid()) @db.Uuid
  schoolId         String              @db.Uuid
  title            String
  description      String?
  coverAssetId     String?             @db.Uuid
  startAt          DateTime
  endAt            DateTime?
  venue            String?
  coverUrl         String?
  originSchoolName String?
  scope            EventScope          @default(SCHOOL)
  status           EventStatus         @default(DRAFT)
  createdByUserId  String?             @db.Uuid
  approvedByUserId String?             @db.Uuid
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ticketTypes      EventTicketType[]
  registrations    EventRegistration[]

  @@index([schoolId])
  @@index([scope, status])
}

/// A thing you can register for. An event has one or many; a free event has a
/// single type priced at zero rather than no type at all, so every event is
/// registered for the same way.
model EventTicketType {
  id            String              @id @default(uuid()) @db.Uuid
  eventId       String              @db.Uuid
  schoolId      String              @db.Uuid
  name          String
  /// Minor units — paise, cents. NEVER a float: rounding error in money is the
  /// bug you find in reconciliation months later and never fully clean up.
  priceMinor    Int                 @default(0)
  currency      String              @default("INR")
  /// null = unlimited. 0 is a real value meaning "sold out by configuration".
  capacity      Int?
  salesOpenAt   DateTime?
  salesCloseAt  DateTime?
  createdAt     DateTime            @default(now())
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([eventId])
  @@index([schoolId])
}

/// One person's place at one event.
///
/// It lives in the HOST school's tenant — `schoolId` is the host, and that is
/// what RLS scopes on. The host owns its attendee list; that single decision is
/// what stops one school reading another's registrations, and it is why a
/// student of school A registering for school B's network event writes a row
/// into B rather than A.
model EventRegistration {
  id           String @id @default(uuid()) @db.Uuid
  eventId      String @db.Uuid
  /// The HOST school. Not the registrant's.
  schoolId     String @db.Uuid
  ticketTypeId String @db.Uuid
  quantity     Int    @default(1)

  /// Signed in: the student, who may belong to another school in the network.
  studentId    String? @db.Uuid
  /// Which school the registrant came from — the first thing an admin asks
  /// about a network registration, and not derivable from `schoolId` (that is
  /// the host). Null for a true guest.
  fromSchoolId String? @db.Uuid

  /// Signed out: a public-site registration. Exactly one of studentId or
  /// guestEmail is expected; the service enforces it.
  guestName  String?
  guestEmail String?
  guestPhone String?

  status        RegistrationStatus @default(HELD)
  /// Copied from the ticket type at registration time. If a school raises the
  /// price mid-sale, people who already registered keep the price they agreed
  /// to — the record must not be re-derivable from a mutable ticket type.
  amountMinor   Int                @default(0)
  currency      String             @default("INR")
  paymentStatus PaymentStatus      @default(NOT_REQUIRED)
  /// Position in the queue when WAITLISTED, so "you are third" can be said.
  waitlistPos   Int?
  checkedInAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  payments   EventPayment[]

  /// One place per student per event. A family needing two seats uses
  /// `quantity`, not a second row — otherwise capacity cannot be counted.
  @@unique([eventId, studentId])
  @@index([schoolId, eventId])
  @@index([eventId, status])
  @@index([fromSchoolId])
  @@index([schoolId, ticketTypeId])
}

/// Money that changed hands. Written today by an admin recording cash at the
/// office (`provider = "MANUAL"`), and by a gateway later — the same row, which
/// is the entire reason to build this table before there is a gateway to fill
/// it. When one arrives, nothing above this table moves.
model EventPayment {
  id             String            @id @default(uuid()) @db.Uuid
  registrationId String            @db.Uuid
  schoolId       String            @db.Uuid
  provider       String            @default("MANUAL")
  providerRef    String?
  amountMinor    Int
  currency       String            @default("INR")
  status         PaymentStatus     @default(PAID)
  /// The admin who recorded it, when it was taken by hand.
  recordedBy     String?           @db.Uuid
  note           String?
  createdAt      DateTime          @default(now())
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([registrationId])
}

// Single-use, short-lived tokens for the self-serve "forgot password" flow.
// Only the sha256 hash is stored; the raw token lives in the emailed link.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Enquiry {
  id            String        @id @default(uuid()) @db.Uuid
  schoolId      String        @db.Uuid
  parentName    String
  phone         String
  email         String?
  gradeInterest String?
  message       String?
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Announcement {
  id              String        @id @default(uuid()) @db.Uuid
  schoolId        String        @db.Uuid
  classSectionId  String?       @db.Uuid
  title           String
  body            String
  createdByUserId String?       @db.Uuid
  createdAt       DateTime      @default(now())
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection    ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([schoolId, classSectionId])
}

// ── Platform-level marketing (sckools.com site) ─────────────────────────────
// No tenant / RLS: these belong to the platform itself, like School and the
// platform-scoped User rows.

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model MarketingLead {
  id        String     @id @default(uuid()) @db.Uuid
  name      String?
  phone     String
  school    String?
  interest  String?
  source    String
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([status, createdAt])
}

/// Singleton (id = "default"): owner-editable pricing + public contact info.
model MarketingConfig {
  id            String   @id @default("default")
  priceBasicUsd Int      @default(19)
  priceBasicInr Int      @default(999)
  priceStdUsd   Int      @default(49)
  priceStdInr   Int      @default(2499)
  priceProUsd   Int      @default(99)
  priceProInr   Int      @default(4999)
  contactEmail  String   @default("admin@sckools.com")
  contactPhone  String   @default("")
  updatedAt     DateTime @updatedAt
}

/// One-time 15-minute owner→school-admin login handoff (sha256 at rest,
/// single-use, host-bound at exchange time). Mirrors PasswordResetToken.
model ImpersonationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  schoolId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Blog platform ────────────────────────────────────────────────────────

enum BlogScope {
  PLATFORM
  SCHOOL
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum BlogGlobalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model BlogPost {
  id           String                @id @default(uuid()) @db.Uuid
  scope        BlogScope
  schoolId     String?               @db.Uuid
  slug         String
  title        String
  description  String
  heroImageUrl String?
  readMinutes  Int                   @default(4)
  sections     Json // BlogBlock[] — see Block Schema
  status       BlogStatus            @default(DRAFT)
  globalStatus BlogGlobalStatus      @default(NONE)
  globalSlug   String?               @unique // set on global approval; PLATFORM posts: = slug
  rejectReason String?
  publishedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  school       School?               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  selections   SchoolBlogSelection[]

  @@unique([schoolId, slug])
  @@index([scope, globalStatus, status, publishedAt(sort: Desc)])
  @@index([schoolId, status, publishedAt(sort: Desc)])
}

model SchoolBlogSelection {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  postId    String   @db.Uuid
  isHero    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([schoolId, postId])
  @@index([schoolId, isHero, sortOrder])
}

// ── Class notes, to-dos and register change requests ────────────────────

enum RegisterChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A teacher's running notes about one class on one day. Scoped to the class
/// and the date, not to the teacher, so a co-teacher of the same section sees
/// the same log — the point is continuity for the class, not a private diary.
model ClassNote {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @db.Uuid
  classSectionId  String       @db.Uuid
  subjectId       String       @db.Uuid
  date            DateTime     @db.Date
  body            String
  authorTeacherId String       @db.Uuid
  createdAt       DateTime     @default(now())
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection    ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([schoolId, classSectionId, date, subjectId])
}

/// A tickable task a teacher sets for one class on one day.
model ClassTodo {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @db.Uuid
  classSectionId  String       @db.Uuid
  subjectId       String       @db.Uuid
  date            DateTime     @db.Date
  body            String
  done            Boolean      @default(false)
  authorTeacherId String       @db.Uuid
  createdAt       DateTime     @default(now())
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection    ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([schoolId, classSectionId, date, subjectId])
}

/// A request to reopen a past day's register. Registers lock at the end of
/// their own day; an APPROVED request re-opens exactly one (class, date)
/// until `expiresAt`, after which it locks again without needing revocation.
model RegisterChangeRequest {
  id                   String               @id @default(uuid()) @db.Uuid
  schoolId             String               @db.Uuid
  classSectionId       String               @db.Uuid
  date                 DateTime             @db.Date
  requestedByTeacherId String               @db.Uuid
  reason               String
  status               RegisterChangeStatus @default(PENDING)
  reviewedByUserId     String?              @db.Uuid
  reviewedAt           DateTime?
  expiresAt            DateTime?
  createdAt            DateTime             @default(now())
  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection         ClassSection         @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([schoolId, classSectionId, date])
}

// ── The Daily Diary (Phase 5·3) ──────────────────────────────────────────────
// The paper diary a child carries home, made digital. A teacher writes ITEMs
// (homework, notices, "bring your art file") and REMARKs (the red-ink note a
// parent has to sign). Both are filed against ONE (class, date) — a diary page
// — and either address the whole class or a typed-in shortlist of students.
//
// Deliberately a SEPARATE table from ClassNote/ClassTodo, which are the
// teachers' own handover log for a (class, date, subject) and are never shown
// to a family. A diary entry is the opposite: it exists to be read at home.

/// ITEM = the ordinary diary line every family reads. REMARK = red ink about
/// specific children; it always emails the parent and asks for a signature.
enum DiaryEntryKind {
  ITEM
  REMARK
}

/// ALL = the whole class section reads it. SELECTED = only the students in
/// `recipients` (the type-a-name picker). A REMARK is always SELECTED — there
/// is no such thing as a remark about everybody.
enum DiaryAudience {
  ALL
  SELECTED
}

model DiaryEntry {
  id              String           @id @default(uuid()) @db.Uuid
  schoolId        String           @db.Uuid
  classSectionId  String           @db.Uuid
  /// Optional: a diary line is often just "the class diary", not a subject's.
  subjectId       String?          @db.Uuid
  date            DateTime         @db.Date
  kind            DiaryEntryKind   @default(ITEM)
  audience        DiaryAudience    @default(ALL)
  body            String
  /// Teacher.id — attribution only, exactly like ClassNote.authorTeacherId.
  /// Authorization is always resolved through `classSectionId`.
  authorTeacherId String           @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection    ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject         Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  recipients      DiaryRecipient[]
  acks            DiaryAck[]

  /// The diary page: one class's entries for one day.
  @@index([schoolId, classSectionId, date])
  @@index([schoolId, subjectId])
}

/// Who a SELECTED entry is addressed to. Absent entirely for `audience: ALL`
/// (a whole-class entry stores no per-student rows — a 60-child class would
/// otherwise write 60 rows to say "everyone").
model DiaryRecipient {
  id        String     @id @default(uuid()) @db.Uuid
  schoolId  String     @db.Uuid
  entryId   String     @db.Uuid
  studentId String     @db.Uuid
  entry     DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([entryId, studentId], name: "one_recipient_per_entry_student")
  @@index([schoolId, studentId])
}

/// Read receipt + parent signature, written LAZILY: a row appears the first
/// time that child's diary renders the entry, and gains `signedAt`/`signedName`
/// when the parent signs a REMARK. Kept separate from DiaryRecipient because
/// an `audience: ALL` entry has no recipient rows but still needs per-child
/// receipts — and because "addressed to" and "has been read" are different
/// facts with different lifetimes.
model DiaryAck {
  id         String     @id @default(uuid()) @db.Uuid
  schoolId   String     @db.Uuid
  entryId    String     @db.Uuid
  studentId  String     @db.Uuid
  seenAt     DateTime   @default(now())
  signedAt   DateTime?
  /// Typed by whoever signs ("Priya Sharma") — the digital equivalent of the
  /// parent's initials in the margin, stored as free text on purpose.
  signedName String?
  entry      DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([entryId, studentId], name: "one_ack_per_entry_student")
  @@index([schoolId, studentId])
}

/// A receipt for the attendance bar's one-tap "tell these families" action.
/// Exists to enforce the cooldown (a family is never nagged twice in the same
/// week about the same thing) and to show the teacher who was already told.
model AttendanceNotice {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  studentId       String   @db.Uuid
  classSectionId  String   @db.Uuid
  /// The child's percentage AT THE MOMENT of sending, and the benchmark the
  /// teacher had the slider on — both frozen so a later recovery doesn't
  /// rewrite the history of what the family was told.
  percent         Int
  threshold       Int
  sentByTeacherId String   @db.Uuid
  sentAt          DateTime @default(now())
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// The cooldown lookup: this student's most recent notice.
  @@index([schoolId, studentId, sentAt])
  @@index([schoolId, classSectionId, sentAt])
}

/// ── Hiring ──────────────────────────────────────────────────────────────────
/// A vacancy, the questions it screens on, and the applications against it.
/// Deliberately the shape of event registrations: a thing, an application
/// against it, and a status the host owns.
///
/// Hiring appears ONLY on sckools.com — never on a school's own site — which is
/// what makes owner approval load-bearing: every post lands on the owner's own
/// front door. See docs/superpowers/specs/2026-08-05-hiring-design.md.
enum JobStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

/// TEXT is the only kind that cannot become a filter, and the builder says so.
enum JobQuestionKind {
  CHOICE
  YES_NO
  NUMBER
  TEXT
}

enum JobApplicationStatus {
  NEW
  SHORTLISTED
  INTERVIEWING
  REJECTED
  HIRED
}

model JobPost {
  id               String           @id @default(uuid()) @db.Uuid
  schoolId         String           @db.Uuid
  title            String
  summary          String
  description      String
  employmentType   EmploymentType   @default(FULL_TIME)
  /// Free text — "Physics", "Primary". A filter on the board.
  subject          String?
  /// How many people the school needs. An Int, NOT a boolean "is open":
  /// schools hire in batches and "we need three" is the most useful fact on a
  /// listing. It deliberately does NOT interact with applications — nothing
  /// decrements it and nothing auto-closes.
  posts            Int              @default(1)
  /// Minor units — paise, cents. Never a float.
  salaryMinMinor   Int?
  salaryMaxMinor   Int?
  currency         String           @default("INR")
  applyBy          DateTime?
  status           JobStatus        @default(DRAFT)
  /// The owner owes a reason when refusing.
  rejectedReason   String?
  createdByUserId  String?          @db.Uuid
  approvedByUserId String?          @db.Uuid
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  questions        JobQuestion[]
  applications     JobApplication[]

  @@index([schoolId])
  @@index([status])
}

model JobQuestion {
  id        String          @id @default(uuid()) @db.Uuid
  jobPostId String          @db.Uuid
  /// Carried for RLS, exactly as EventTicketType carries it.
  schoolId  String          @db.Uuid
  prompt    String
  kind      JobQuestionKind @default(CHOICE)
  /// CHOICE only.
  options   String[]
  required  Boolean         @default(false)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  jobPost   JobPost         @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@index([jobPostId])
  @@index([schoolId])
}

/// THE MOST SENSITIVE DATA THIS PRODUCT STORES: a private individual's name,
/// phone and CV link, submitted by somebody with no account. It belongs to the
/// hiring school ALONE — RLS is single-tenant with no cross-school read, now or
/// later, even when someone asks for network-wide candidate search.
model JobApplication {
  id        String               @id @default(uuid()) @db.Uuid
  jobPostId String               @db.Uuid
  /// The HIRING school. Always derived from the vacancy, never from a request.
  schoolId  String               @db.Uuid
  name      String
  email     String
  phone     String?
  /// A LINK, not a file. There is no public upload endpoint in this product.
  cvUrl     String
  /// { [questionId]: string | number | boolean } — at most four entries.
  answers   Json?
  status    JobApplicationStatus @default(NEW)
  /// The school's own private note about the candidate.
  note      String?
  createdAt DateTime             @default(now())
  jobPost   JobPost              @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@index([jobPostId])
  @@index([schoolId])
}

// ── Library ──────────────────────────────────────────────
//
// The Library Wing: one librarian login (STAFF + StaffRole.LIBRARIAN) runs the
// whole library from /library. Money is whole rupees (Int) — fines are small,
// paise would be false precision. Fines ACCRUE while a book is out (computed,
// never stored) and CRYSTALLIZE into a LibraryFine row at return or write-off.

enum LibraryFineReason {
  LATE
  LOST
}

enum LibraryFineStatus {
  DUE
  PAID
  WAIVED
}

enum LibraryHallSource {
  /// Confirmed from the class teacher's register of the same day.
  SYNCED
  /// The librarian marked the class herself.
  RETAKEN
}

/// One row per school, created on first read with the approved defaults. The
/// librarian edits it from the portal gear; the school admin edits the same row
/// from Admin → Settings → Library.
model LibrarySettings {
  id                  String   @id @default(uuid()) @db.Uuid
  schoolId            String   @unique @db.Uuid
  /// How many classes fit in the hall at the same time.
  hallCapacityClasses Int      @default(2)
  studentLoanLimit    Int      @default(2)
  teacherLoanLimit    Int      @default(5)
  /// dueOn = issuedOn + loanDays.
  loanDays            Int      @default(14)
  /// Per late day, applied after graceDays.
  finePerDayRupees    Int      @default(5)
  graceDays           Int      @default(1)
  /// Flat replacement charge for a lost copy.
  lostFeeRupees       Int      @default(120)
  /// OFF ⇒ teachers never see or owe fines, and none accrue on their loans.
  fineTeachers        Boolean  @default(false)
  /// Email + push, 3 days before dueOn (the library-due-soon cron).
  dueSoonReminders    Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model LibraryBookTitle {
  id        String            @id @default(uuid()) @db.Uuid
  schoolId  String            @db.Uuid
  title     String
  author    String
  shelf     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  copies    LibraryBookCopy[]

  @@index([schoolId])
}

model LibraryBookCopy {
  id          String           @id @default(uuid()) @db.Uuid
  schoolId    String           @db.Uuid
  titleId     String           @db.Uuid
  /// The human book number printed on the sticker: B-00001, B-00002, …
  /// Allocated like Student.code (lexicographic max + 1 inside the tx); the
  /// unique index below is the race backstop.
  accessionNo String
  /// Set when the copy is written off (lost/damaged beyond repair). A lost
  /// copy never counts as available and is never issuable again.
  lostAt      DateTime?
  createdAt   DateTime         @default(now())
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       LibraryBookTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)
  issues      LibraryIssue[]

  @@unique([schoolId, accessionNo])
  @@index([schoolId, titleId])
}

/// One loan. Exactly one of studentId/teacherId is set (the StaffAttendance
/// XOR convention). An open loan is returnedOn = NULL — a partial unique index
/// (migration SQL: one open issue per copy) makes double-issue of the same
/// physical copy impossible regardless of application races.
model LibraryIssue {
  id           String          @id @default(uuid()) @db.Uuid
  schoolId     String          @db.Uuid
  copyId       String          @db.Uuid
  studentId    String?         @db.Uuid
  teacherId    String?         @db.Uuid
  issuedOn     DateTime        @db.Date
  dueOn        DateTime        @db.Date
  returnedOn   DateTime?       @db.Date
  /// This loan ended with the copy written off (see LibraryBookCopy.lostAt).
  wasLost      Boolean         @default(false)
  issuedById   String          @db.Uuid // User.id of the librarian at the counter
  returnedById String?         @db.Uuid // User.id
  createdAt    DateTime        @default(now())
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  copy         LibraryBookCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  student      Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher?        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  fines        LibraryFine[]

  @@index([schoolId, returnedOn])
  @@index([schoolId, studentId])
  @@index([schoolId, teacherId])
  @@index([schoolId, copyId])
  @@index([schoolId, dueOn])
}

/// A crystallized amount owed — created at return time (LATE) or write-off
/// (LOST), never while the book is still out. "Collect later" is simply a DUE
/// row that outlives the return.
model LibraryFine {
  id           String            @id @default(uuid()) @db.Uuid
  schoolId     String            @db.Uuid
  issueId      String            @db.Uuid
  /// Borrower copied from the issue so per-reader lists need no join.
  studentId    String?           @db.Uuid
  teacherId    String?           @db.Uuid
  amountRupees Int
  reason       LibraryFineReason
  status       LibraryFineStatus @default(DUE)
  settledById  String?           @db.Uuid // User.id of the librarian who collected/waived
  settledAt    DateTime?
  createdAt    DateTime          @default(now())
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issue        LibraryIssue      @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([schoolId, studentId])
  @@index([schoolId, teacherId])
  @@index([schoolId, issueId])
}

/// A class's library-period attendance, saved by the librarian — either
/// confirmed from the class teacher's register (SYNCED) or taken fresh
/// (RETAKEN). One visit per class per day.
model LibraryHallVisit {
  id             String            @id @default(uuid()) @db.Uuid
  schoolId       String            @db.Uuid
  classSectionId String            @db.Uuid // ClassSection.id (bare, as Attendance does)
  date           DateTime          @db.Date
  periodId       String?           @db.Uuid // Period.id when derived from the timetable
  source         LibraryHallSource
  savedById      String            @db.Uuid // User.id of the librarian
  createdAt      DateTime          @default(now())
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  marks          LibraryHallMark[]

  @@unique([schoolId, classSectionId, date])
  @@index([schoolId, date])
}

model LibraryHallMark {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @db.Uuid
  visitId   String           @db.Uuid
  studentId String           @db.Uuid // Student.id (bare; roster names come from Student)
  status    AttendanceStatus
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  visit     LibraryHallVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, studentId])
  @@index([schoolId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Homecoming — the alumni wing.
//
// The one fact the whole module turns on: a school does not have an alumni
// database, it has a graduating class every March. `Alumni` is therefore
// written FROM `Student` at year end (studentId set, zero typing) and only
// secondarily from a self-registration that a human verifies against the old
// register (studentId null).
//
// Alumni are adults and students are children, so nothing here ever exposes a
// child to a donor or a guest speaker: `GiftPledge` addresses a GROUP and
// stores the headcount, never a student; `GuestSession` addresses a class and
// requires a named accompanying teacher before it can be scheduled.
// ═══════════════════════════════════════════════════════════════════════════

enum AlumniStatus {
  /// Created by "graduate this batch". Real, but has never signed in.
  SCHOOL_ADDED
  /// A claim link has been sent.
  INVITED
  /// Self-registered from the public site. Visible to the office and NOBODY else.
  PENDING
  /// A human matched them against the register, or a claim link proved it.
  VERIFIED
  DECLINED
  /// The alumnus's own choice, and instant.
  HIDDEN
}

enum ClaimStatus {
  PENDING
  VERIFIED
  DECLINED
}

enum GiftScope {
  SCHOOL
  GRADE
  SECTION
}

enum GiftMode {
  /// The donor pays; the school buys. Money runs on the school's merchant rail.
  FUND
  /// The donor sends the goods. No money moves here and NO rupee valuation is
  /// ever stored — an in-kind gift is a register of things, counted in things.
  SUPPLY
}

enum GiftStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  /// School suggested a different gift; waiting on the donor.
  COUNTERED
  CANCELLED
  RECEIVED
  DISTRIBUTED
  REPORTED
}

enum GiftDedication {
  NONE
  IN_MEMORY_OF
  IN_HONOUR_OF
}

enum GiftVisibility {
  /// Name and gift on the school website. The AMOUNT is never public.
  PUBLIC
  ALUMNI
  /// The office sees the name for its books; nobody else does.
  ANONYMOUS
}

enum GuestSessionMode {
  IN_PERSON
  ONLINE
}

enum GuestSessionStatus {
  REQUESTED
  /// The school suggested another time. Both slots are held until the host answers.
  COUNTERED
  /// Terminal-happy: written into the timetable.
  SCHEDULED
  DECLINED
  CANCELLED
  DELIVERED
}

/// A former student. One row per person per school.
model Alumni {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  /// Set when the row came from "graduate this batch"; null for a recovered
  /// pre-Sckools alumnus. NOT a foreign key with cascade delete — deleting a
  /// student record must never silently erase the alumni record built from it.
  studentId String? @db.Uuid
  /// Set once they claim a login. Null is the normal state.
  userId    String? @db.Uuid

  admissionNo String?
  firstName   String
  lastName    String
  /// The leaving year. An Int, because every screen in this module groups by it.
  batchYear   Int
  lastClass   String?

  email       String?
  phone       String?
  city        String?
  country     String?
  profession  String?
  employer    String?
  collegeName String?
  photoAssetId String? @db.Uuid

  status AlumniStatus @default(SCHOOL_ADDED)
  /// A SECOND decision, separate from `status`. Being a real alumnus gets you
  /// the directory; it does not get you a room full of fourteen-year-olds.
  /// Revoking it cancels their future sessions — see AlumniService.setTrusted.
  trustedForStudents Boolean @default(false)
  isBatchCaptain     Boolean @default(false)
  isMentor           Boolean @default(false)
  isDeceased         Boolean @default(false)

  /// { field: PUBLIC | ALUMNI | BATCH | OFFICE | HIDDEN }. Absent key = HIDDEN,
  /// so a field added later is closed until somebody opens it.
  privacy Json?

  verifiedByUserId String?   @db.Uuid
  verifiedAt       DateTime?
  declineReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school        School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  giftPledges   GiftPledge[]
  guestSessions GuestSession[]

  /// One alumni row per student. Re-running "graduate this batch" is therefore
  /// idempotent rather than duplicating a whole year group.
  @@unique([schoolId, studentId])
  @@index([schoolId, batchYear])
  @@index([schoolId, status])
  @@index([schoolId, trustedForStudents])
}

/// The denominator Roll Call needs. The SIS knows how many alumni it created;
/// only the bound register knows how many were in the room in 1998.
model AlumniBatch {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @db.Uuid
  batchYear        Int
  /// From the old register, typed in once. 0 means "not counted yet".
  registerStrength Int      @default(0)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, batchYear])
  @@index([schoolId])
}

/// A public self-registration awaiting a human. The JobApplication shape: an
/// application row plus a review queue, deliberately NOT an Alumni row — an
/// unverified stranger must not exist in the same table the directory reads.
model AlumniClaim {
  id                String  @id @default(uuid()) @db.Uuid
  schoolId          String  @db.Uuid
  firstName         String
  lastName          String
  batchYear         Int
  claimedAdmissionNo String?
  email             String?
  phone             String?
  /// Free text: a class teacher's name, two classmates, a link to a marksheet.
  /// A LINK, never a file — there is no public upload endpoint in this product.
  proof             String

  status ClaimStatus @default(PENDING)
  /// Set when the office merges the claim into a row that already exists.
  matchedAlumniId   String? @db.Uuid
  /// A vouch does NOT verify anyone. It moves them to the top of the queue with
  /// a name attached to the recommendation.
  vouchedByAlumniId String? @db.Uuid

  reviewedByUserId String?   @db.Uuid
  reviewedAt       DateTime?
  declineReason    String?
  createdAt        DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([schoolId, batchYear])
}

/// The school's own wish list. Written by the school, never by us and never by
/// a donor — the worst outcome this module can produce is three hundred
/// unwanted T-shirts nobody can refuse politely.
model GiftItem {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name     String
  /// "per child", "per classroom".
  unit     String @default("per child")
  /// Minor units — paise. NEVER a float: rounding error in money is the bug you
  /// find in reconciliation months later and never fully clean up.
  indicativeCostMinor Int    @default(0)
  currency            String @default("INR")
  /// Shoes and sweaters need a size tally; notebooks do not.
  sizesTracked Boolean @default(false)
  isActive     Boolean @default(true)
  order        Int     @default(0)
  createdAt    DateTime @default(now())

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  pledges GiftPledge[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

/// One gift, from proposal to report. A gift is not a payment — it is a small
/// supply chain, and every state carries a date.
model GiftPledge {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid

  /// Signed in: the alumnus. Signed out: a parent or a local donor, by name.
  /// Exactly one of alumniId or donorName is expected; the service enforces it.
  alumniId   String? @db.Uuid
  donorName  String?
  donorEmail String?

  scopeKind      GiftScope
  gradeId        String? @db.Uuid
  classSectionId String? @db.Uuid

  /// FROZEN at pledge time, exactly like EventRegistration.amountMinor. A pledge
  /// for 38 sweaters must not silently become 41 because three children joined
  /// in July — the donor agreed to a number and that number is the agreement.
  headcountAtPledge Int

  giftItemId    String? @db.Uuid
  /// Off-catalogue. Arrives as a PROPOSED pledge the office can counter.
  customRequest String?
  /// Always equals headcountAtPledge on creation: a class of 38 with 20 sweaters
  /// is a worse place than one with none. It is a column and not a computation
  /// because the office may top a short pledge up.
  quantity      Int

  mode GiftMode
  /// FUND only. Null for SUPPLY — an in-kind gift never carries a valuation,
  /// which keeps donated goods out of the fee ledger and out of the audit.
  amountMinor Int?
  currency    String @default("INR")

  dedicationKind GiftDedication @default(NONE)
  dedicationText String?
  visibility     GiftVisibility @default(ALUMNI)

  status        GiftStatus @default(PROPOSED)
  declineReason String?
  counterNote   String?
  /// SUPPLY only: when the donor said the goods would arrive.
  dueAt         DateTime?

  acceptedByUserId String?   @db.Uuid
  acceptedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school        School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  alumni        Alumni?            @relation(fields: [alumniId], references: [id], onDelete: SetNull)
  giftItem      GiftItem?          @relation(fields: [giftItemId], references: [id], onDelete: SetNull)
  receipts      GiftReceipt[]
  distributions GiftDistribution[]

  @@index([schoolId, status])
  @@index([schoolId, createdAt])
  @@index([alumniId])
  @@index([giftItemId])
  @@index([schoolId, classSectionId])
}

/// What actually arrived. Pledged and received are two different numbers and
/// both get written down — 38 promised, 36 delivered is a real and common event.
model GiftReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  pledgeId       String   @db.Uuid
  receivedQty    Int
  receivedAt     DateTime @default(now())
  receivedByUserId String? @db.Uuid
  note           String?

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  pledge GiftPledge @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([schoolId, pledgeId])
  @@index([pledgeId])
}

/// The handing out. `absentQty` exists because the school already knows the 38
/// children, so "two absent, collected Monday" is a fact and not an estimate.
model GiftDistribution {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  pledgeId       String   @db.Uuid
  classSectionId String?  @db.Uuid
  distributedQty Int
  absentQty      Int      @default(0)
  distributedAt  DateTime @default(now())
  byUserId       String?  @db.Uuid
  note           String?

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  pledge GiftPledge @relation(fields: [pledgeId], references: [id], onDelete: Cascade)

  @@index([schoolId, pledgeId])
  @@index([pledgeId])
}

/// A lecture or skill session an alumnus gives to a class. The only feature in
/// Homecoming that puts an adult in a room with children, which is why
/// `accompanyingTeacherId` is checked before SCHEDULED and why only an alumnus
/// with `trustedForStudents` can create one.
model GuestSession {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  alumniId String @db.Uuid

  title   String
  summary String?
  mode    GuestSessionMode @default(IN_PERSON)

  classSectionId String @db.Uuid
  /// Frozen at request time, same reason as GiftPledge.headcountAtPledge.
  headcountAtBooking Int

  /// What the HOST asked for.
  requestedDate     DateTime
  requestedPeriodId String   @db.Uuid
  /// What the SCHOOL suggested back. Both slots are held until the host answers.
  counterDate       DateTime?
  counterPeriodId   String?   @db.Uuid
  counterNote       String?
  /// One counter each, then it is a phone call. Software that lets two people
  /// haggle indefinitely just moves the argument somewhere worse.
  counterRound      Int       @default(0)
  /// Set only on SCHEDULED, and it is whichever of the two above was accepted.
  scheduledDate     DateTime?
  scheduledPeriodId String?   @db.Uuid

  /// REQUIRED before SCHEDULED. The safeguarding rule as a constraint rather
  /// than a paragraph in a policy nobody reads.
  accompanyingTeacherId String? @db.Uuid
  /// Recorded AT DECISION TIME, never inferred later — six months on, "which
  /// period did 9-A lose" is a syllabus question somebody will actually ask.
  displacedSubjectId    String? @db.Uuid
  displacedTeacherId    String? @db.Uuid
  roomId                String? @db.Uuid
  meetingUrl            String?

  status        GuestSessionStatus @default(REQUESTED)
  declineReason String?
  decidedByUserId String?   @db.Uuid
  decidedAt       DateTime?
  deliveredAt     DateTime?
  attendedCount   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  alumni Alumni @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([schoolId, requestedDate])
  @@index([alumniId])
  @@index([schoolId, classSectionId])
  /// NOTE: a PARTIAL unique index also guards this table —
  /// GuestSession_live_slot_key on (schoolId, classSectionId, requestedDate,
  /// requestedPeriodId) WHERE status IN ('REQUESTED','COUNTERED','SCHEDULED').
  /// Prisma cannot express a partial unique index, so it lives in the migration
  /// SQL only and does not appear here. It is what actually prevents two alumni
  /// double-booking one period: the availability check and the insert are in one
  /// transaction, but READ COMMITTED means both would still read FREE.
}
