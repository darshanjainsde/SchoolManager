generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────
enum Tier {
  BASIC
  STANDARD
  PRO
}

enum SchoolStatus {
  SETUP
  LIVE
  SUSPENDED
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  LIVE
  ERROR
}

enum UserRole {
  OWNER
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  /// Non-teaching staff login — distinct from TEACHER/STUDENT so it is never
  /// mistaken for (or granted the portal reach of) either. See
  /// apps/api/src/modules/management/staff.service.ts and
  /// apps/web/app/login/page.tsx.
  STAFF
}

enum MediaKind {
  LOGO
  FAVICON
  HERO
  GALLERY
  STAFF
  EVENT
  PRINCIPAL
  COURSE
  HOF
  ABOUT
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  X
  LINKEDIN
}

enum MenuKind {
  CLASS
  PAGE
  CUSTOM
}

enum EventScope {
  SCHOOL
  NETWORK
}

enum EventStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PeriodKind {
  CLASS
  BREAK
}

enum StaffRole {
  OFFICE
  SUPPORT
  DRIVER
  HELPER
  SECURITY
  OTHER
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PersonAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
}

enum ClassNoteVisibility {
  /// Any teacher who holds the class section can read its notes. Default —
  /// this is the behaviour that shipped, and the least surprising for a small
  /// school where everyone teaches everyone.
  ALL_TEACHERS
  /// A note is scoped to its subject. Readable by teachers who teach that
  /// subject in that section, by a substitute covering it that day, and always
  /// by the section's class teacher.
  SUBJECT_TEACHERS
}

// ── Tenancy & access ─────────────────────────────────────
model School {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String
  slug                String              @unique
  tier                Tier                @default(BASIC)
  status              SchoolStatus        @default(SETUP)
  timezone            String              @default("Asia/Kolkata")
  locale              String              @default("en-IN")
  workingDays         Int[]               @default([1, 2, 3, 4, 5, 6])
  classNoteVisibility ClassNoteVisibility @default(ALL_TEACHERS)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  domains                Domain[]
  featureOverrides       FeatureOverride[]
  users                  User[]
  auditLogs              AuditLog[]
  profile                SchoolProfile?
  homepage               HomepageContent?
  stats                  StatItem[]
  socialLinks            SocialLink[]
  menuItems              MenuItem[]
  media                  MediaAsset[]
  featuredStaff          FeaturedStaff[]
  academicYears          AcademicYear[]
  grades                 Grade[]
  classSections          ClassSection[]
  subjects               Subject[]
  teachers               Teacher[]
  students               Student[]
  periods                Period[]
  timetableSlots         TimetableSlot[]
  events                 Event[]
  enquiries              Enquiry[]
  announcements          Announcement[]
  courses                Course[]
  courseFees             CourseFee[]
  admissionSteps         AdmissionStep[]
  admissionsSettings     AdmissionsSettings?
  hallOfFameEntries      HallOfFameEntry[]
  attendance             Attendance[]
  substitutions          Substitution[]
  staff                  Staff[]
  staffAttendance        StaffAttendance[]
  leaveApplications      LeaveApplication[]
  pushTokens             PushToken[]
  holidays               Holiday[]
  blogPosts              BlogPost[]
  blogSelections         SchoolBlogSelection[]
  notifications          Notification[]
  classNotes             ClassNote[]
  classTodos             ClassTodo[]
  registerChangeRequests RegisterChangeRequest[]
  notificationOutbox     NotificationOutbox[]
  assignments            Assignment[]
  messageThreads         MessageThread[]
  messages               Message[]
}

model Domain {
  id        String       @id @default(uuid()) @db.Uuid
  schoolId  String       @db.Uuid
  hostname  String       @unique
  type      DomainType   @default(SUBDOMAIN)
  status    DomainStatus @default(PENDING)
  isPrimary Boolean      @default(false)
  createdAt DateTime     @default(now())
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model FeatureOverride {
  id         String  @id @default(uuid()) @db.Uuid
  schoolId   String  @db.Uuid
  featureKey String
  enabled    Boolean
  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, featureKey])
  @@index([schoolId])
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  schoolId            String?              @db.Uuid
  email               String
  username            String?
  passwordHash        String
  role                UserRole
  isActive            Boolean              @default(true)
  mfaSecret           String?
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  school              School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  impersonationTokens ImpersonationToken[]

  @@unique([schoolId, email])
  @@unique([schoolId, username])
  @@index([schoolId])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String?   @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
}

/// One registered Expo push device per row, keyed by `token` (Expo issues a
/// new token per app-install, so upsert-by-token is how a re-registering
/// device replaces its stale row rather than accumulating duplicates).
///
/// `email` is denormalised from `User.email` at registration time so
/// `PushChannel.send(email, message)` — which runs with no tenant/schoolId in
/// scope, see notification.types.ts — can look tokens up by the same email
/// address `NotificationService` already fans a message out to.
model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @db.Uuid
  userId     String   @db.Uuid
  email      String
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, email])
  @@index([userId])
}

/// A school-configured holiday/closure shown on both mobile portals'
/// read-only `/me/holidays` calendar. `type` is a plain String rather than a
/// Prisma enum (mirrors `Period.kind`/`LeaveApplication.type`) — one of
/// `'PUBLIC' | 'FESTIVAL' | 'SCHOOL'`, enforced at the DTO/service layer, not
/// the database.
///
/// `startDate`/`endDate` are `@db.Date` — plain calendar dates, no time
/// component — matching `LeaveApplication.startDate`/`endDate`. `endDate` is
/// optional: a single-day holiday only needs `startDate`.
model Holiday {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @db.Uuid
  name      String
  type      String
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(now())
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, startDate])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entity      String
  entityId    String?
  meta        Json?
  createdAt   DateTime @default(now())
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

// ── Website content (CMS) ────────────────────────────────
model SchoolProfile {
  id                  String  @id @default(uuid()) @db.Uuid
  schoolId            String  @unique @db.Uuid
  logoAssetId         String? @db.Uuid
  faviconAssetId      String? @db.Uuid
  brandColorPrimary   String  @default("#3ee6b0")
  brandColorSecondary String  @default("#7c6cff")
  headingFont         String  @default("INTER")
  heroStyle           String  @default("ILLUSTRATION")
  animationLevel      String  @default("FULL")
  themePreset         String?
  // First-screen layout system. heroStyle above is the legacy 3-value field,
  // kept in sync by the CMS service (PHOTO→FULL_BLEED etc.) for old clients.
  heroLayout          String  @default("ILLUSTRATION")
  heroTextAlign       String  @default("LEFT")
  heroOverlayStyle    String  @default("WASH")
  heroOverlayOpacity  Int     @default(65)
  heroHeight          String  @default("FULL")
  headlineAccent      String  @default("DRAW")
  navStyle            String  @default("CLASSIC")
  navColor            String  @default("PAPER")
  navTextColor        String  @default("AUTO")
  navCtaLabel         String  @default("Enquire")
  navShowCta          Boolean @default(true)
  navShowLogin        Boolean @default(true)
  navLoginLabel       String  @default("Login")
  blogLayout          String  @default("HERO_GRID")
  blogHeroLimit       Int     @default(1)
  phone               String?
  email               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  region              String?
  postalCode          String?
  country             String?
  geoLat              Float?
  geoLng              Float?
  mapEmbedUrl         String?
  school              School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model HomepageContent {
  id                    String   @id @default(uuid()) @db.Uuid
  schoolId              String   @unique @db.Uuid
  heroAssetId           String?  @db.Uuid
  headline              String   @default("Welcome")
  subheadline           String?
  aboutText             String?
  principalName         String?
  principalMessage      String?
  principalPhotoAssetId String?  @db.Uuid
  // Wide image for the About section's picture card (campus/community photo);
  // falls back to the principal photo, then a placeholder.
  aboutImageAssetId     String?  @db.Uuid
  // Ordered hero image slots (MediaAsset kind HERO, max 5) for multi-image
  // layouts; heroAssetId above stays in sync with slot 1 for old clients.
  heroImageAssetIds     String[] @default([]) @db.Uuid
  // Which content sections render on the homepage. Full details always live on
  // the dedicated pages (/admissions, /gallery, /connect, /contact).
  showAdmissions        Boolean  @default(true)
  showGallery           Boolean  @default(true)
  showEvents            Boolean  @default(true)
  showContact           Boolean  @default(true)
  school                School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model StatItem {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  label    String
  value    String
  order    Int    @default(0)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SocialLink {
  id       String         @id @default(uuid()) @db.Uuid
  schoolId String         @db.Uuid
  platform SocialPlatform
  url      String
  order    Int            @default(0)
  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model MenuItem {
  id       String     @id @default(uuid()) @db.Uuid
  schoolId String     @db.Uuid
  label    String
  slug     String
  order    Int        @default(0)
  kind     MenuKind   @default(CUSTOM)
  parentId String?    @db.Uuid
  refId    String?    @db.Uuid
  school   School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  @@unique([schoolId, slug])
  @@index([schoolId])
}

model MediaAsset {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @db.Uuid
  kind       MediaKind
  storageKey String
  url        String
  caption    String?
  order      Int       @default(0)
  width      Int?
  height     Int?
  byteSize   Int?
  createdAt  DateTime  @default(now())
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, kind])
}

model FeaturedStaff {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  teacherId    String?  @db.Uuid
  name         String
  role         String
  photoAssetId String?  @db.Uuid
  order        Int      @default(0)
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher      Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

// Public "courses/classes offered" — CMS content for ALL tiers, fully
// separate from the Management (Pro) Grade/ClassSection operational models.
model Course {
  id           String            @id @default(uuid()) @db.Uuid
  schoolId     String            @db.Uuid
  name         String
  tagline      String?
  description  String?
  highlights   String[]          @default([])
  ageRange     String?
  imageAssetId String?           @db.Uuid
  featured     Boolean           @default(false)
  order        Int               @default(0)
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fee          CourseFee?
  hallOfFame   HallOfFameEntry[]

  @@index([schoolId])
}

// Fee amounts are free text ("₹ 68,000" / "On request") — display content, not billing.
model CourseFee {
  id           String  @id @default(uuid()) @db.Uuid
  schoolId     String  @db.Uuid
  courseId     String  @unique @db.Uuid
  admissionFee String?
  annualFee    String?
  includes     String?
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model AdmissionStep {
  id          String  @id @default(uuid()) @db.Uuid
  schoolId    String  @db.Uuid
  title       String
  description String?
  order       Int     @default(0)
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model AdmissionsSettings {
  id               String  @id @default(uuid()) @db.Uuid
  schoolId         String  @unique @db.Uuid
  showFeesPublicly Boolean @default(true)
  feeNote          String?
  school           School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model HallOfFameEntry {
  id           String  @id @default(uuid()) @db.Uuid
  schoolId     String  @db.Uuid
  courseId     String  @db.Uuid
  rank         Int // 1..3
  name         String
  achievement  String?
  year         String?
  photoAssetId String? @db.Uuid
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, rank])
  @@index([schoolId])
}

// ── Management (Pro) ─────────────────────────────────────
model AcademicYear {
  id             String          @id @default(uuid()) @db.Uuid
  schoolId       String          @db.Uuid
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean         @default(false)
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSections  ClassSection[]
  timetableSlots TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Grade {
  id            String         @id @default(uuid()) @db.Uuid
  schoolId      String         @db.Uuid
  name          String
  order         Int            @default(0)
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSections ClassSection[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassSection {
  id                     String                  @id @default(uuid()) @db.Uuid
  schoolId               String                  @db.Uuid
  gradeId                String                  @db.Uuid
  name                   String
  classTeacherId         String?                 @db.Uuid
  academicYearId         String                  @db.Uuid
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade                  Grade                   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  academicYear           AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classTeacher           Teacher?                @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students               Student[]
  timetableSlots         TimetableSlot[]
  announcements          Announcement[]
  classNotes             ClassNote[]
  classTodos             ClassTodo[]
  registerChangeRequests RegisterChangeRequest[]
  notificationOutbox     NotificationOutbox[]
  assignments            Assignment[]
  messageThreads         MessageThread[]

  @@unique([schoolId, gradeId, name, academicYearId])
  @@index([schoolId])
}

model Subject {
  id              String           @id @default(uuid()) @db.Uuid
  schoolId        String           @db.Uuid
  name            String
  code            String
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]
  timetableSlots  TimetableSlot[]
  classNotes      ClassNote[]
  classTodos      ClassTodo[]
  assignments     Assignment[]
  messageThreads  MessageThread[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Teacher {
  id               String           @id @default(uuid()) @db.Uuid
  schoolId         String           @db.Uuid
  userId           String?          @db.Uuid
  firstName        String
  lastName         String
  email            String?
  phone            String?
  photoAssetId     String?          @db.Uuid
  primarySubjectId String?          @db.Uuid
  bio              String?
  isActive         Boolean          @default(true)
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects  TeacherSubject[]
  classSections    ClassSection[]   @relation("ClassTeacher")
  timetableSlots   TimetableSlot[]
  featuredIn       FeaturedStaff[]
  messageThreads   MessageThread[]

  @@index([schoolId])
}

model TeacherSubject {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @db.Uuid
  teacherId String  @db.Uuid
  subjectId String  @db.Uuid
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([schoolId])
}

model Student {
  id              String           @id @default(uuid()) @db.Uuid
  schoolId        String           @db.Uuid
  admissionNo     String
  firstName       String
  lastName        String
  email           String?
  classSectionId  String?          @db.Uuid
  rollNo          String?
  dob             DateTime?
  gender          String?
  guardianName    String?
  guardianPhone   String?
  photoAssetId    String?          @db.Uuid
  userId          String?          @unique @db.Uuid
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection    ClassSection?    @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  attendance      Attendance[]
  results         Result[]
  assignmentsSeen AssignmentSeen[]
  messageThreads  MessageThread[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, classSectionId])
}

model Period {
  id             String          @id @default(uuid()) @db.Uuid
  schoolId       String          @db.Uuid
  order          Int
  label          String
  startTime      String
  endTime        String
  kind           PeriodKind      @default(CLASS)
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]

  @@unique([schoolId, order])
  @@index([schoolId])
}

model TimetableSlot {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @db.Uuid
  classSectionId String       @db.Uuid
  dayOfWeek      Int
  periodId       String       @db.Uuid
  subjectId      String       @db.Uuid
  teacherId      String       @db.Uuid
  academicYearId String       @db.Uuid
  effectiveFrom  DateTime     @default(now())
  effectiveTo    DateTime?
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  period         Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classSectionId, dayOfWeek, periodId, academicYearId, effectiveFrom], name: "class_slot")
  @@unique([schoolId, teacherId, dayOfWeek, periodId, academicYearId, effectiveFrom], name: "teacher_slot")
  @@index([schoolId])
  @@index([schoolId, classSectionId, effectiveFrom])
  @@index([schoolId, teacherId, effectiveFrom])
}

// ── Academics: attendance, exams, results ────────────────
model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  studentId      String           @db.Uuid
  classSectionId String           @db.Uuid
  date           DateTime         @db.Date
  status         AttendanceStatus
  markedById     String           @db.Uuid // Teacher.id
  createdAt      DateTime         @default(now())
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date], name: "one_mark_per_student_day")
  @@index([schoolId, classSectionId, date])
}

model Substitution {
  id                  String   @id @default(uuid()) @db.Uuid
  schoolId            String   @db.Uuid
  classSectionId      String   @db.Uuid
  periodId            String   @db.Uuid
  date                DateTime @db.Date
  originalTeacherId   String   @db.Uuid
  substituteTeacherId String?  @db.Uuid // null = uncovered gap
  reason              String? // e.g. "leave"
  createdAt           DateTime @default(now())
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, periodId, date], name: "one_sub_per_slot_date")
  @@index([schoolId, date])
}

model Staff {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @db.Uuid
  firstName String
  lastName  String
  role      StaffRole @default(OTHER)
  email     String?
  phone     String?
  userId    String?   @db.Uuid
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model StaffAttendance {
  id         String                 @id @default(uuid()) @db.Uuid
  schoolId   String                 @db.Uuid
  teacherId  String?                @db.Uuid
  staffId    String?                @db.Uuid
  date       DateTime               @db.Date
  status     PersonAttendanceStatus
  markedById String?                @db.Uuid
  createdAt  DateTime               @default(now())
  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date], name: "one_teacher_mark_per_day")
  @@unique([staffId, date], name: "one_staff_mark_per_day")
  @@index([schoolId, date])
}

model LeaveApplication {
  id           String      @id @default(uuid()) @db.Uuid
  schoolId     String      @db.Uuid
  teacherId    String      @db.Uuid
  type         LeaveType
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?     @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([schoolId, teacherId])
}

model Exam {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  classSectionId String   @db.Uuid
  subjectId      String   @db.Uuid
  title          String
  scheduledAt    DateTime
  syllabus       String?
  maxMarks       Int
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  results        Result[]

  @@index([schoolId, classSectionId, scheduledAt])
}

model Result {
  id          String    @id @default(uuid()) @db.Uuid
  examId      String    @db.Uuid
  studentId   String    @db.Uuid
  marks       Float
  publishedAt DateTime?
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId], name: "one_result_per_exam_student")
}

/// Transactional outbox for "families' phones get told" events (S6/S7 wiring,
/// Portal Parity R3 Phase 4 Task 2). `ExamsService.create()`/`publish()`
/// write one row here IN THE SAME `withTenant` transaction as the exam/result
/// write itself — so a result is never published without its notification
/// row existing, and a rolled-back transaction leaves no orphan row either.
/// A cron drain (`NotificationOutboxService`, `internal/cron/notification-outbox`)
/// reads unsent rows and sends push via the existing `PushChannel`, then sets
/// `sentAt`. `kind` is a plain String (not a Prisma enum) validated at write
/// time via `assertNotificationOutboxKind` (`@skoolos/types`) — matches the
/// String-kind pattern already used for `LeaveApplication.type`/`Holiday.type`
/// elsewhere in this schema.
///
/// `payload` is DENORMALISED at write time (exam title, subject/class name,
/// maxMarks/date already resolved to display strings) so the drain never
/// joins back to `Exam`/`Subject`/`ClassSection` — see
/// `ExamScheduledOutboxPayload`/`ResultPublishedOutboxPayload`
/// (apps/api/src/common/notifications/notification.types.ts).
model NotificationOutbox {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @db.Uuid
  kind           String
  payload        Json
  classSectionId String       @db.Uuid
  /// When set, the drain pushes to THIS single user only (a private message —
  /// MESSAGE_RECEIVED), instead of resolving the whole classSectionId's
  /// section recipients. Null for the broadcast kinds (exam/result/assignment).
  targetUserId   String?      @db.Uuid
  createdAt      DateTime     @default(now())
  sentAt         DateTime?
  /// Incremented on every failed send attempt; the drain excludes rows at
  /// or above its MAX_ATTEMPTS cap rather than retrying forever.
  attempts       Int          @default(0)
  lastError      String?
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  /// The drain's own query shape: unsent rows, oldest first.
  @@index([schoolId, sentAt])
}

/// A teacher-posted assignment for one class section (T21, Portal Parity R3
/// Phase 4 Task 4). `attachments` is a denormalised JSON array of
/// `{ url, name, kind }` (`kind`: `'pdf' | 'image'`), each uploaded via
/// `POST /manage/assignments/upload` — a THIN endpoint that delegates
/// straight to `StorageService` (the shared S3/MinIO client also used by
/// `MediaService`), NOT the CMS media service itself: `MediaService`/
/// `MediaAsset` are scoped to a fixed site-content `kind` taxonomy
/// (LOGO/HERO/GALLERY/…), image-only, and carry no `@Roles` guard at all —
/// wrong shape and wrong ACL for a teacher-facing PDF/image attachment (see
/// `AssignmentsController`'s docstring for the full reasoning).
///
/// v1 has NO submission uploads (a marking workflow, deliberately cut) —
/// tracking is per-class visibility plus `AssignmentSeen` "opened" marks
/// only.
///
/// `createdByTeacherId` stores the CALLER'S `User.id` — mirrors
/// `Exam.createdById` exactly, including its reasoning: this field is
/// ATTRIBUTION ONLY, never the authorization gate. Ownership for
/// create/list/delete is resolved entirely via `classSectionId` through
/// `assertClassOwned`/`AttendanceService.myClassSections`, the SAME rule
/// `ExamsService` uses (covering-only teachers excluded) — never a second,
/// creator-based check.
model Assignment {
  id                 String   @id @default(uuid()) @db.Uuid
  schoolId           String   @db.Uuid
  classSectionId     String   @db.Uuid
  subjectId          String   @db.Uuid
  title              String
  instructions       String
  dueDate            DateTime @db.Date
  attachments        Json     @default("[]")
  createdByTeacherId String   @db.Uuid
  createdAt          DateTime @default(now())

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  seen         AssignmentSeen[]

  @@index([schoolId, classSectionId, dueDate])
}

/// A student's "seen/opened" mark for an `Assignment` — v1's ONLY tracking
/// signal (see `Assignment`'s docstring: no submission uploads yet).
/// `AssignmentsService.markSeen` upserts on the unique pair below, so a
/// student re-opening the same assignment twice never creates a second row
/// — idempotent by construction, not by a pre-check.
///
/// No `schoolId` column of its own — tenancy is derived via
/// `assignmentId -> Assignment.schoolId`, the SAME pattern `Result`'s RLS
/// policy already uses for `examId -> Exam.schoolId` (see the migration).
model AssignmentSeen {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @db.Uuid
  studentId    String   @db.Uuid
  seenAt       DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId], name: "one_seen_per_assignment_student")
}

// Messaging (Phase 4 Task 5 / item T17). A student asks one of the teachers who
// actually teaches them (a subject, from the timetable) a question; the teacher
// replies. One thread per (student, teacher, subject). `teacherId` is a
// Teacher.id (matching TimetableSlot.teacherId), `studentId` a Student.id — the
// authorization join is against the timetable, never client-supplied ids.
model MessageThread {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @db.Uuid
  studentId      String   @db.Uuid
  teacherId      String   @db.Uuid
  subjectId      String   @db.Uuid
  classSectionId String   @db.Uuid
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([studentId, teacherId, subjectId], name: "one_thread_per_student_teacher_subject")
  @@index([schoolId, teacherId, lastMessageAt])
  @@index([schoolId, studentId, lastMessageAt])
}

model Message {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @db.Uuid
  threadId   String    @db.Uuid
  senderRole String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// In-app notification inbox — the per-user, per-event rows behind the bell in
/// both portals (unread count + notification list). DISTINCT from
/// `NotificationOutbox`, which is a fire-and-forget PUSH queue with no per-user
/// read state: a `Notification` row PERSISTS until its recipient reads it, and
/// `readAt` is what the bell's unread count decrements against.
///
/// Rows are written SYNCHRONOUSLY, inside the SAME `withTenant` transaction as
/// the domain event (a new message, a scheduled exam, a published result, a
/// posted assignment) via `emitNotifications`
/// (apps/api/src/common/notifications/notification-inbox.ts) — right beside the
/// matching `NotificationOutbox` write. That keeps in-app notifications
/// IMMEDIATE regardless of the outbox drain's cron cadence, and all-or-nothing
/// with the event itself.
///
/// `userId` is the RECIPIENT's `User.id` (student or teacher login), kept as a
/// bare scalar with NO Prisma relation / FK — the SAME choice as
/// `PushToken.userId`: a hard user delete simply orphans harmless unread rows,
/// and the `schoolId` cascade still clears them when a school is removed. `kind`
/// is a plain String validated by `assertNotificationKind` (@skoolos/types),
/// mirroring `NotificationOutbox.kind`. `linkType`/`linkId` are an optional
/// deep-link the client resolves to a route BY ROLE (e.g. linkType `thread` +
/// a threadId → the student's or teacher's own thread route).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @db.Uuid
  userId    String    @db.Uuid
  kind      String
  title     String
  body      String?
  linkType  String?
  linkId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// unread count + unread list for one user (the bell's hot path)
  @@index([schoolId, userId, readAt])
  /// recent list, newest-first (the paginated notification screen)
  @@index([schoolId, userId, createdAt])
}

// ── Community ────────────────────────────────────────────
model Event {
  id               String      @id @default(uuid()) @db.Uuid
  schoolId         String      @db.Uuid
  title            String
  description      String?
  coverAssetId     String?     @db.Uuid
  startAt          DateTime
  endAt            DateTime?
  venue            String?
  coverUrl         String?
  originSchoolName String?
  scope            EventScope  @default(SCHOOL)
  status           EventStatus @default(DRAFT)
  createdByUserId  String?     @db.Uuid
  approvedByUserId String?     @db.Uuid
  approvedAt       DateTime?
  createdAt        DateTime    @default(now())
  school           School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([scope, status])
}

// Single-use, short-lived tokens for the self-serve "forgot password" flow.
// Only the sha256 hash is stored; the raw token lives in the emailed link.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Enquiry {
  id            String        @id @default(uuid()) @db.Uuid
  schoolId      String        @db.Uuid
  parentName    String
  phone         String
  email         String?
  gradeInterest String?
  message       String?
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Announcement {
  id              String        @id @default(uuid()) @db.Uuid
  schoolId        String        @db.Uuid
  classSectionId  String?       @db.Uuid
  title           String
  body            String
  createdByUserId String?       @db.Uuid
  createdAt       DateTime      @default(now())
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection    ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([schoolId, classSectionId])
}

// ── Platform-level marketing (sckools.com site) ─────────────────────────────
// No tenant / RLS: these belong to the platform itself, like School and the
// platform-scoped User rows.

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model MarketingLead {
  id        String     @id @default(uuid()) @db.Uuid
  name      String?
  phone     String
  school    String?
  interest  String?
  source    String
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([status, createdAt])
}

/// Singleton (id = "default"): owner-editable pricing + public contact info.
model MarketingConfig {
  id            String   @id @default("default")
  priceBasicUsd Int      @default(19)
  priceBasicInr Int      @default(999)
  priceStdUsd   Int      @default(49)
  priceStdInr   Int      @default(2499)
  priceProUsd   Int      @default(99)
  priceProInr   Int      @default(4999)
  contactEmail  String   @default("admin@sckools.com")
  contactPhone  String   @default("")
  updatedAt     DateTime @updatedAt
}

/// One-time 15-minute owner→school-admin login handoff (sha256 at rest,
/// single-use, host-bound at exchange time). Mirrors PasswordResetToken.
model ImpersonationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  schoolId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Blog platform ────────────────────────────────────────────────────────

enum BlogScope {
  PLATFORM
  SCHOOL
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum BlogGlobalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model BlogPost {
  id           String                @id @default(uuid()) @db.Uuid
  scope        BlogScope
  schoolId     String?               @db.Uuid
  slug         String
  title        String
  description  String
  heroImageUrl String?
  readMinutes  Int                   @default(4)
  sections     Json // BlogBlock[] — see Block Schema
  status       BlogStatus            @default(DRAFT)
  globalStatus BlogGlobalStatus      @default(NONE)
  globalSlug   String?               @unique // set on global approval; PLATFORM posts: = slug
  rejectReason String?
  publishedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  school       School?               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  selections   SchoolBlogSelection[]

  @@unique([schoolId, slug])
  @@index([scope, globalStatus, status, publishedAt(sort: Desc)])
  @@index([schoolId, status, publishedAt(sort: Desc)])
}

model SchoolBlogSelection {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  postId    String   @db.Uuid
  isHero    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([schoolId, postId])
  @@index([schoolId, isHero, sortOrder])
}

// ── Class notes, to-dos and register change requests ────────────────────

enum RegisterChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A teacher's running notes about one class on one day. Scoped to the class
/// and the date, not to the teacher, so a co-teacher of the same section sees
/// the same log — the point is continuity for the class, not a private diary.
model ClassNote {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @db.Uuid
  classSectionId  String       @db.Uuid
  subjectId       String       @db.Uuid
  date            DateTime     @db.Date
  body            String
  authorTeacherId String       @db.Uuid
  createdAt       DateTime     @default(now())
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection    ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([schoolId, classSectionId, date, subjectId])
}

/// A tickable task a teacher sets for one class on one day.
model ClassTodo {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @db.Uuid
  classSectionId  String       @db.Uuid
  subjectId       String       @db.Uuid
  date            DateTime     @db.Date
  body            String
  done            Boolean      @default(false)
  authorTeacherId String       @db.Uuid
  createdAt       DateTime     @default(now())
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection    ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([schoolId, classSectionId, date, subjectId])
}

/// A request to reopen a past day's register. Registers lock at the end of
/// their own day; an APPROVED request re-opens exactly one (class, date)
/// until `expiresAt`, after which it locks again without needing revocation.
model RegisterChangeRequest {
  id                   String               @id @default(uuid()) @db.Uuid
  schoolId             String               @db.Uuid
  classSectionId       String               @db.Uuid
  date                 DateTime             @db.Date
  requestedByTeacherId String               @db.Uuid
  reason               String
  status               RegisterChangeStatus @default(PENDING)
  reviewedByUserId     String?              @db.Uuid
  reviewedAt           DateTime?
  expiresAt            DateTime?
  createdAt            DateTime             @default(now())
  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSection         ClassSection         @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([schoolId, classSectionId, date])
}
