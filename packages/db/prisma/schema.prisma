  firstName         String
  lastName          String
  email             String?
  classSectionId    String?            @db.Uuid
  rollNo            String?
  dob               DateTime?
  gender            String?
  guardianName      String?
  guardianPhone     String?
  photoAssetId      String?            @db.Uuid
  userId            String?            @unique @db.Uuid
  isActive          Boolean            @default(true)
