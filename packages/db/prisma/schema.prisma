generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────
enum Tier {
  BASIC
  STANDARD
  PRO
}

enum SchoolStatus {
  SETUP
  LIVE
  SUSPENDED
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  LIVE
  ERROR
}

/// How a school's outbound mail is sent. DEFAULT = through the platform's own
/// mailbox wearing the school's name (the always-works fallback); CUSTOM = the
/// school's own SMTP credentials, but only once a live test send has passed.
enum EmailSenderMode {
  DEFAULT
  CUSTOM
}

/// Lifecycle of a school's own sender. A school sits at UNVERIFIED until a
/// real test send succeeds; FAILING is set when live sending later breaks, and
/// mail silently falls back to the platform sender rather than stopping.
enum EmailSenderStatus {
  UNVERIFIED
  VERIFIED
  FAILING
}

enum UserRole {
  OWNER
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  /// Non-teaching staff login — distinct from TEACHER/STUDENT so it is never
  /// mistaken for (or granted the portal reach of) either. See
  /// apps/api/src/modules/management/staff.service.ts and
  /// apps/web/app/login/page.tsx.
  STAFF
  /// LEGACY — the first library line modelled the librarian as a login ROLE.
  /// The Library Wing replaced that with one staff login kind: the JOB
  /// (Staff.role = LIBRARIAN) decides the door via /auth/me's staffRole, and
  /// the 20260816090000_library_wing migration folds any LIBRARIAN users back
  /// to STAFF. The value stays listed because Postgres enum values are
  /// effectively permanent and the staging database carries it; nothing may
  /// mint it again.
  LIBRARIAN
}

enum MediaKind {
  LOGO
  FAVICON
  HERO
  GALLERY
  STAFF
  EVENT
  PRINCIPAL
  COURSE
  HOF
  ABOUT
  /// Self-uploaded profile photo (student/teacher/staff) via POST /me/photo —
  /// Phase 5·0d. Distinct from STAFF, which is the CMS featured-staff imagery.
  AVATAR
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  X
  LINKEDIN
}

enum MenuKind {
  CLASS
  PAGE
  CUSTOM
}

enum EventScope {
  SCHOOL
  NETWORK
}

enum EventStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  HELD
  CONFIRMED
  WAITLISTED
  DECLINED
  CANCELLED
}

/// Deliberately present before there is any gateway. `NOT_REQUIRED` is what a
/// free event carries, so "free" is not a separate code path that lets the paid
/// branch rot — it is the same path with a zero price.
enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PeriodKind {
  CLASS
  BREAK
}

enum StaffRole {
  OFFICE
  SUPPORT
  DRIVER
  HELPER
  SECURITY
  /// Runs the school library — the only staff role that unlocks /library.
  /// The login stays ordinary STAFF; /auth/me's `staffRole` carries this value
  /// so the web login can pick the door. Adding roles here never changes what
  /// a login can do.
  LIBRARIAN
  OTHER
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PersonAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
}

enum ClassNoteVisibility {
  /// Any teacher who holds the class section can read its notes. Default —
  /// this is the behaviour that shipped, and the least surprising for a small
  /// school where everyone teaches everyone.
  ALL_TEACHERS
  /// A note is scoped to its subject. Readable by teachers who teach that
  /// subject in that section, by a substitute covering it that day, and always
  /// by the section's class teacher.
  SUBJECT_TEACHERS
}

// ── Tenancy & access ─────────────────────────────────────
model School {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String
  slug                String              @unique
  /// 3-letter prefix for student codes (RAF-00042). Derived from the school
  /// name on first allocation and persisted so codes stay stable (Phase 5·1).
  codePrefix          String?
  tier                Tier                @default(BASIC)
  status              SchoolStatus        @default(SETUP)
  timezone            String              @default("Asia/Kolkata")
  locale              String              @default("en-IN")
  workingDays         Int[]               @default([1, 2, 3, 4, 5, 6])
  classNoteVisibility ClassNoteVisibility @default(ALL_TEACHERS)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  domains                Domain[]
  emailSettings          EmailSettings?
  featureOverrides       FeatureOverride[]
  users                  User[]
  auditLogs              AuditLog[]
  profile                SchoolProfile?
  homepage               HomepageContent?
  stats                  StatItem[]
  socialLinks            SocialLink[]
  menuItems              MenuItem[]
  media                  MediaAsset[]
  featuredStaff          FeaturedStaff[]
  academicYears          AcademicYear[]
  grades                 Grade[]
  classSections          ClassSection[]
  subjects               Subject[]
  teachers               Teacher[]
  students               Student[]
  periods                Period[]
  timetableSlots         TimetableSlot[]
  events                 Event[]
  enquiries              Enquiry[]
  announcements          Announcement[]
  courses                Course[]
  courseFees             CourseFee[]
  admissionSteps         AdmissionStep[]
  admissionsSettings     AdmissionsSettings?
  hallOfFameEntries      HallOfFameEntry[]
  attendance             Attendance[]
  substitutions          Substitution[]
  staff                  Staff[]
  staffAttendance        StaffAttendance[]
  leaveApplications      LeaveApplication[]
  leaveTypeDefs          LeaveTypeDef[]
  leaveAllocations       LeaveAllocation[]
  pushTokens             PushToken[]
  holidays               Holiday[]
  blogPosts              BlogPost[]
  blogSelections         SchoolBlogSelection[]
  notifications          Notification[]
  classNotes             ClassNote[]
  classTodos             ClassTodo[]
  registerChangeRequests RegisterChangeRequest[]
  notificationOutbox     NotificationOutbox[]
  assignments            Assignment[]
  messageThreads         MessageThread[]
  messages               Message[]
  diaryEntries           DiaryEntry[]
  attendanceNotices      AttendanceNotice[]
  jobPosts               JobPost[]
  librarySettings        LibrarySettings?
  designDrafts           DesignDraft[]
  sitePages              SchoolPage[]
  libraryBookTitles      LibraryBookTitle[]
  libraryBookCopies      LibraryBookCopy[]
  libraryIssues          LibraryIssue[]
  libraryFines           LibraryFine[]
  libraryHallVisits      LibraryHallVisit[]
  libraryHallMarks       LibraryHallMark[]
  results                Result[]
  assignmentsSeen        AssignmentSeen[]
  rooms                  Room[]
  seatingPlans           SeatingPlan[]
  alumni                 Alumni[]
  alumniBatches          AlumniBatch[]
  alumniClaims           AlumniClaim[]
  giftItems              GiftItem[]
  giftPledges            GiftPledge[]
  giftReceipts           GiftReceipt[]
  giftDistributions      GiftDistribution[]
  guestSessions          GuestSession[]
}

model Domain {
  id        String       @id @default(uuid()) @db.Uuid
  schoolId  String       @db.Uuid
  hostname  String       @unique
  type      DomainType   @default(SUBDOMAIN)
  status    DomainStatus @default(PENDING)
  isPrimary Boolean      @default(false)
  createdAt DateTime     @default(now())
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// A school's letterhead and (optionally) its own outbound sender.
///
/// Every field is nullable and the row itself is optional: a school with no
/// row still gets fully branded mail, because the renderer falls back to the
/// name, logo and colour it already set for its website. This table only holds
/// DELIBERATE overrides — which is what makes the default path safe.
model EmailSettings {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @unique @db.Uuid

  // ── Letterhead (always applied, configured or not) ──
  /// CLASSIC | BANNER | MINIMAL — see letterhead.ts.
  template    String   @default("CLASSIC")
  /// Overrides the From display name. Null = the school's own name.
  senderName  String?
  /// Where replies land. Null = no Reply-To header.
  replyTo     String?
  /// Overrides the letterhead accent. Null = SchoolProfile.brandColorPrimary.
  accentColor String?
  /// Overrides the crest. Null = SchoolProfile.logoAssetId.
  logoAssetId String?  @db.Uuid
  /// Address / phone / office email, rendered as the footer's small print.
  footerLines String[] @default([])

  // ── Own sender (optional, verified before use) ──
  senderMode   EmailSenderMode   @default(DEFAULT)
  senderStatus EmailSenderStatus @default(UNVERIFIED)
  /// The address mail is sent AS, e.g. office@theirschool.in — or a Gmail box.
  fromAddress  String?
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  /// AES-256-GCM ciphertext, never returned by any API. Encrypted with
  /// EMAIL_SECRET_KEY, which lives only in the environment — a database dump
  /// alone does not yield a school's mailbox password.
  smtpPassEnc  String?
  verifiedAt   DateTime?
  /// Why the last send failed, shown to the admin so a broken sender is
  /// visible rather than silently dropping mail to the fallback forever.
  lastError    String?
  lastErrorAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model FeatureOverride {
  id         String  @id @default(uuid()) @db.Uuid
  schoolId   String  @db.Uuid
  featureKey String
  enabled    Boolean
  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, featureKey])
  @@index([schoolId])
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  schoolId            String?              @db.Uuid
  email               String
  username            String?
  passwordHash        String
  role                UserRole
  isActive            Boolean              @default(true)
  mfaSecret           String?
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  school              School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  impersonationTokens ImpersonationToken[]

  @@unique([schoolId, email])
  @@unique([schoolId, username])
  @@index([schoolId])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String?   @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
}

/// One registered Expo push device per row, keyed by `token` (Expo issues a
/// new token per app-install, so upsert-by-token is how a re-registering
/// device replaces its stale row rather than accumulating duplicates).
///
/// `email` is denormalised from `User.email` at registration time so
/// `PushChannel.send(email, message)` — which runs with no tenant/schoolId in
/// scope, see notification.types.ts — can look tokens up by the same email
/// address `NotificationService` already fans a message out to.
model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @db.Uuid
  userId     String   @db.Uuid
  email      String
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, email])
  @@index([userId])
}

/// A school-configured holiday/closure shown on both mobile portals'
/// read-only `/me/holidays` calendar. `type` is a plain String rather than a
/// Prisma enum (mirrors `Period.kind`/`LeaveApplication.type`) — one of
/// `'PUBLIC' | 'FESTIVAL' | 'SCHOOL'`, enforced at the DTO/service layer, not
/// the database.
///
/// `startDate`/`endDate` are `@db.Date` — plain calendar dates, no time
/// component — matching `LeaveApplication.startDate`/`endDate`. `endDate` is
/// optional: a single-day holiday only needs `startDate`.
model Holiday {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @db.Uuid
  name      String
  type      String
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(now())
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, startDate])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entity      String
  entityId    String?
  meta        Json?
  createdAt   DateTime @default(now())
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

// ── Website content (CMS) ────────────────────────────────
model SchoolProfile {
  id                  String  @id @default(uuid()) @db.Uuid
  schoolId            String  @unique @db.Uuid
  logoAssetId         String? @db.Uuid
  faviconAssetId      String? @db.Uuid
  brandColorPrimary   String  @default("#3ee6b0")
  brandColorSecondary String  @default("#7c6cff")
  headingFont         String  @default("INTER")
  heroStyle           String  @default("ILLUSTRATION")
  animationLevel      String  @default("FULL")
  themePreset         String?
  // First-screen layout system. heroStyle above is the legacy 3-value field,
  // kept in sync by the CMS service (PHOTO→FULL_BLEED etc.) for old clients.
  heroLayout          String  @default("ILLUSTRATION")
  heroTextAlign       String  @default("LEFT")
  heroOverlayStyle    String  @default("WASH")
  heroOverlayOpacity  Int     @default(65)
  heroHeight          String  @default("FULL")
  headlineAccent      String  @default("DRAW")
  /// How every band BELOW the fold is shaped — radius, border, shadow, padding.
  /// The first screen already had seven layouts; this is the control that makes
  /// the rest of the page differ between schools by more than two colours.
  /// SOFT (pillowy cards) | EDITORIAL (ruled, boxless) | CRISP (bordered).
  sectionShape        String  @default("SOFT")
  /// WHAT a section does as it arrives, not how much of it: RISE (default,
  /// today's behaviour) | FADE | DRAW. animationLevel stays the volume knob —
  /// NONE still silences everything.
  motionGesture       String  @default("RISE")
  /// A quiet repeating ground for the page paper, drawn from the school's own
  /// --ps1: NONE (default) | GRID | DOTS | PAPER.
  backgroundTexture   String  @default("NONE")
  /// The school's own arrangement of its menu: groups, their labels, their
  /// FROZEN slugs and what sits under each. Null = the default five-control
  /// model, which is what every school has until an admin rearranges it.
  navConfig           Json?
  navStyle            String  @default("CLASSIC")
  navColor            String  @default("PAPER")
  navTextColor        String  @default("AUTO")
  navCtaLabel         String  @default("Enquire")
  navShowCta          Boolean @default(true)
  navShowLogin        Boolean @default(true)
  navLoginLabel       String  @default("Login")
  /// How the sign-in control is drawn: LINK (default, a plain nav link) |
  /// OUTLINE (a bordered chip) | SOLID (a filled chip). Both non-default styles
  /// derive from the bar's own text colour, so neither can be configured into
  /// invisibility on a dark or brand bar.
  navLoginStyle       String  @default("LINK")
  /// How the page MOVES as a visitor scrolls — a fourth style axis beside
  /// shape, gesture and texture. CLASSIC (default, exactly today's behaviour) |
  /// GLIDE (weighted inertial scroll) | SNAP (sections click into place) |
  /// DECK (sections stack over one another like cards).
  scrollFeel          String  @default("CLASSIC")
  /// How an open nav menu arrives: FADE (default — today's ps-menu-in) |
  /// SLIDE (drops in from the tab) | SCALE (grows from the tab corner).
  navDropdownAnim     String  @default("FADE")
  /// First-screen background medium. IMAGE (default) keeps today's photo
  /// slots; VIDEO plays heroVideoUrl muted on loop with the photo slots as
  /// poster/fallback for slow connections and reduced-motion visitors.
  heroMedia           String  @default("IMAGE")
  heroVideoUrl        String?
  /// Per-section layout + entrance overrides, keyed by section id
  /// (stats/about/courses/admissions/gallery/staff), each value
  /// { layout?, gesture? }. Null = every section at its default — today's page.
  sectionVariants     Json?
  /// Festive overlay: { festival, variant, intensity, ribbon, recolor }.
  /// A doodle layer OVER the base design, never a rewrite of it. Null = none.
  festiveTheme        Json?
  /// Footer arrangement: { layout, color, social, contact, tagline }.
  /// Null = the built-in three-column footer every school renders today.
  footerConfig        Json?
  /// Operator escape hatch: per-section CSS overrides keyed by section id.
  /// Values are sanitized on write (site-content.service) and scoped to their
  /// section at render (scopeSectionCss) — never emitted raw.
  customSectionCss    Json?
  /// One sanitized HTML block rendered before the footer. Allow-listed tags
  /// only; sanitized server-side on write, never trusted at render.
  customHtmlBlock     String?
  blogLayout          String  @default("HERO_GRID")
  blogHeroLimit       Int     @default(1)
  phone               String?
  email               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  region              String?
  postalCode          String?
  country             String?
  geoLat              Float?
  geoLng              Float?
  mapEmbedUrl         String?
  school              School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model HomepageContent {
  id                    String   @id @default(uuid()) @db.Uuid
  schoolId              String   @unique @db.Uuid
  heroAssetId           String?  @db.Uuid
  headline              String   @default("Welcome")
  subheadline           String?
  aboutText             String?
  principalName         String?
  principalMessage      String?
  principalPhotoAssetId String?  @db.Uuid
  // Wide image for the About section's picture card (campus/community photo);
  // falls back to the principal photo, then a placeholder.
  aboutImageAssetId     String?  @db.Uuid
  // Ordered hero image slots (MediaAsset kind HERO, max 5) for multi-image
  // layouts; heroAssetId above stays in sync with slot 1 for old clients.
  heroImageAssetIds     String[] @default([]) @db.Uuid
  // Which content sections render on the homepage. Full details always live on
  // the dedicated pages (/admissions, /gallery, /connect, /contact).
  showAdmissions        Boolean  @default(true)
  showGallery           Boolean  @default(true)
  showEvents            Boolean  @default(true)
  showContact           Boolean  @default(true)
  school                School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// A saved website look — the design subset of SchoolProfile as one JSON blob.
/// "Preview" renders it client-side without touching the live site; "Publish"
/// copies it into SchoolProfile. A [publishAt, revertAt] window is a READ-TIME
/// overlay: the public projection merges the config while now() is inside the
/// window, so a festival edition applies and removes itself with no scheduler
/// and no state transition (see docs/superpowers/plans/2026-08-19-website-studio.md).
model DesignDraft {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @db.Uuid
  name      String
  config    Json
  publishAt DateTime?
  revertAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, publishAt])
}

/// An admin-built extra page (Transport, Scholarships, Alumni…): typed content
/// blocks, never raw HTML. The slug is FROZEN at creation like nav slugs —
/// shared links survive renames. Reached at /p/<slug> and placed in the menu
/// through navConfig with the page key "page:<slug>".
model SchoolPage {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  slug      String
  title     String
  blocks    Json
  published Boolean  @default(true)
  /// When false the page is reachable only from the FOOTER, never the navbar —
  /// for secondary pages (Privacy, Careers) that shouldn't spend a nav slot.
  /// Default true keeps every existing page in the navbar as before.
  showInNav Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, slug])
  @@index([schoolId, order])
}

model StatItem {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  label    String
  value    String
  order    Int    @default(0)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SocialLink {
  id       String         @id @default(uuid()) @db.Uuid
  schoolId String         @db.Uuid
  platform SocialPlatform
  url      String
  order    Int            @default(0)
  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model MenuItem {
  id       String     @id @default(uuid()) @db.Uuid
  schoolId String     @db.Uuid
  label    String
  slug     String
  order    Int        @default(0)
  kind     MenuKind   @default(CUSTOM)
  parentId String?    @db.Uuid
  refId    String?    @db.Uuid
  school   School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  @@unique([schoolId, slug])
  @@index([schoolId])
}

model MediaAsset {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @db.Uuid
  kind       MediaKind
  storageKey String
  url        String
  caption    String?
  order      Int       @default(0)
  width      Int?
  height     Int?
  byteSize   Int?
  createdAt  DateTime  @default(now())
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, kind])
}

model FeaturedStaff {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  teacherId    String?  @db.Uuid
  name         String
  role         String
  photoAssetId String?  @db.Uuid
  order        Int      @default(0)
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher      Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([schoolId, teacherId])
}

// Public "courses/classes offered" — CMS content for ALL tiers, fully
// separate from the Management (Pro) Grade/ClassSection operational models.
model Course {
  id           String            @id @default(uuid()) @db.Uuid
  schoolId     String            @db.Uuid
  name         String
  tagline      String?
  description  String?
  highlights   String[]          @default([])
  ageRange     String?
  imageAssetId String?           @db.Uuid
  featured     Boolean           @default(false)
  order        Int               @default(0)
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fee          CourseFee?
  hallOfFame   HallOfFameEntry[]

  @@index([schoolId])
}

// Fee amounts are free text ("₹ 68,000" / "On request") — display content, not billing.
model CourseFee {
  id           String  @id @default(uuid()) @db.Uuid
  schoolId     String  @db.Uuid
  courseId     String  @unique @db.Uuid
  admissionFee String?
  annualFee    String?
  includes     String?
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, courseId])
}

model AdmissionStep {
  id          String  @id @default(uuid()) @db.Uuid
  schoolId    String  @db.Uuid
  title       String
  description String?
  order       Int     @default(0)
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model AdmissionsSettings {
  id               String  @id @default(uuid()) @db.Uuid
  schoolId         String  @unique @db.Uuid
  showFeesPublicly Boolean @default(true)
  feeNote          String?
  school           School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model HallOfFameEntry {
  id           String  @id @default(uuid()) @db.Uuid
  schoolId     String  @db.Uuid
  courseId     String  @db.Uuid
  rank         Int // 1..3
  name         String
  achievement  String?
  year         String?
  photoAssetId String? @db.Uuid
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, rank])
  @@index([schoolId])
}

// ── Management (Pro) ─────────────────────────────────────
model AcademicYear {
  id               String            @id @default(uuid()) @db.Uuid
  schoolId         String            @db.Uuid
  name             String
  startDate        DateTime
  endDate          DateTime
  isCurrent        Boolean           @default(false)
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSections    ClassSection[]
  timetableSlots   TimetableSlot[]
  leaveAllocations LeaveAllocation[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Grade {
  id            String         @id @default(uuid()) @db.Uuid
  schoolId      String         @db.Uuid
  name          String
  order         Int            @default(0)
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSections ClassSection[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassSection {
  id                     String                  @id @default(uuid()) @db.Uuid
  schoolId               String                  @db.Uuid
  gradeId                String                  @db.Uuid
  name                   String
  classTeacherId         String?                 @db.Uuid
  academicYearId         String                  @db.Uuid
