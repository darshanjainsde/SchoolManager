generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("LIBRARY_DATABASE_URL")
  directUrl = env("LIBRARY_DIRECT_URL")
}

enum Plan {
  FREE
  MINI
  PRO
}

enum OrgStatus {
  SETUP
  LIVE
  SUSPENDED
}

enum LibDomainType {
  SUBDOMAIN
  CUSTOM
}

enum LibDomainStatus {
  PENDING
  LIVE
  ERROR
}

/// Library logins. MemberType drives circulation policy and is deliberately a
/// separate axis — a TEACHER member has no administrative reach.
enum LibRole {
  ORG_OWNER
  LIBRARIAN
  ASSISTANT
  MEMBER
}

enum MemberType {
  STUDENT
  TEACHER
  EXTERNAL
}

enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model LibraryOrg {
  id           String    @id @default(uuid()) @db.Uuid
  slug         String    @unique
  name         String
  plan         Plan      @default(FREE)
  status       OrgStatus @default(SETUP)
  currency     String    @default("INR")
  timezone     String    @default("Asia/Kolkata")
  locale       String    @default("en-IN")
  contactEmail String?
  contactPhone String?

  /// The Sckools `School.id` this library belongs to, when the services are
  /// linked. Null until then — the library runs standalone and must keep
  /// working that way.
  ///
  /// Unique because the merge plan is one LibraryOrg per School (§13). Nullable
  /// uniqueness is safe in Postgres: many NULLs coexist, so unlinked orgs do
  /// not collide with each other.
  ///
  /// Added BEFORE the library ever held real data. The same column added later
  /// is a migration against live rows on a table every request touches — this
  /// costs nothing now and is the cheapest insurance in the schema.
  schoolId     String?   @unique @db.Uuid

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  domains    LibraryDomain[]
  theme      OrgTheme?
  branches   Branch[]
  users      LibUser[]
  members    Member[]
  overrides  PlanOverride[]
  titles     Title[]
  authors    Author[]
  categories Category[]
  copies     Copy[]
  policies   CirculationPolicy[]
  issues     Issue[]
  reservations Reservation[]
  fines      Fine[]
  lostReports LostReport[]
  outbox     NotificationOutbox[]

  settings   LibrarySettings?
  periods    LibraryPeriod[]
  visits     ClassVisit[]
  attendance VisitAttendance[]
}

model LibraryDomain {
  id        String          @id @default(uuid()) @db.Uuid
  orgId     String          @db.Uuid
  hostname  String          @unique
  type      LibDomainType   @default(SUBDOMAIN)
  status    LibDomainStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model OrgTheme {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @unique @db.Uuid
  logoUrl          String?
  primaryColor     String   @default("#2E3A87")
  accentColor      String   @default("#8F671D")
  receiptHeader    String?
  receiptFooter    String?
  /// Per-org display labels for the fixed MemberType enum, e.g.
  /// {"EXTERNAL":"Alumni"}. The enum stays fixed because CirculationPolicy is
  /// keyed on it; only the label is configurable.
  memberTypeLabels Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model PlanOverride {
  id      String  @id @default(uuid()) @db.Uuid
  orgId   String  @db.Uuid
  key     String
  enabled Boolean

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId])
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  code      String
  address   String?
  phone     String?
  openTime  String?
  closeTime String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      LibraryOrg          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members  Member[]
  copies   Copy[]
  issues   Issue[]
  reservations Reservation[]
  policies CirculationPolicy[]

  @@unique([orgId, code])
  @@index([orgId])

  periods LibraryPeriod[]
  visits  ClassVisit[]
  lostReports LostReport[]
}

model LibUser {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @db.Uuid
  email          String?
  phone          String?
  passwordHash   String
  role           LibRole
  branchIds      String[]  @db.Uuid
  memberId       String?   @unique @db.Uuid
  active         Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org           LibraryOrg     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member        Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  refresh       RefreshToken[]
  issuesMade    Issue[]         @relation("IssueIssuedBy")
  issuesTakenBack Issue[]         @relation("IssueReturnedBy")
  finesWaived   Fine[]         @relation("FineWaivedBy")
  fineAmountsSet Fine[]        @relation("FineAmountSetBy")
  finesPaidTaken Fine[]        @relation("FinePaidBy")
  lostReported   LostReport[]  @relation("LostReportReportedBy")
  lostConfirmed  LostReport[]  @relation("LostReportConfirmedBy")
  lostSettled    LostReport[]  @relation("LostReportSettledBy")
  lostRefunded   LostReport[]  @relation("LostReportRefundedBy")

  @@unique([orgId, email])
  @@unique([orgId, phone])
  @@index([orgId])
}

model Member {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @db.Uuid
  homeBranchId     String?      @db.Uuid
  code             String
  memberType       MemberType   @default(STUDENT)
  firstName        String
  lastName         String
  phone            String?
  email            String?
  photoUrl         String?
  address          String?
  customFields     Json         @default("{}")
  status           MemberStatus @default(PENDING)
  joinedAt         DateTime     @default(now())
  /// null = no expiry. Membership expiry is computed from this at read time,
  /// never stored as a status — see the no-scheduler rule in the spec (§6.3).
  membershipEndsAt DateTime?
  /// The class this member belongs to, as the librarian writes it (`6-B`).
  ///
  /// Plain text and nullable on purpose: the library period must work before
  /// the Sckools link exists, so this is typed by hand today and populated by
  /// the one-way sync later. A foreign key to Sckools' ClassSection would make
  /// this phase depend on a phase that has not happened.
  classRef         String?

  /// Holds the Sckools Student.id / Teacher.id when the services merge.
  /// Present from the first migration so the merge needs no schema change.
  externalRef      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  org        LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  homeBranch Branch?    @relation(fields: [homeBranchId], references: [id], onDelete: SetNull)
  login      LibUser?
  issues     Issue[]
  reservations Reservation[]
  fines      Fine[]
  lostReports LostReport[]

  @@unique([orgId, code])
  @@index([orgId, status])
  @@index([orgId, externalRef])

  visitAttendance VisitAttendance[]
  @@index([homeBranchId])
}

/// Hash-keyed and single-use. Deliberately has no RLS policy — see the
/// allow-list in the RLS coverage audit (Task 3).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  /// Set when this token was rotated normally. Within the service's grace
  /// window of this timestamp, a replay of this (now-revoked) token is
  /// treated as a duplicate request — a client retry racing the winner of a
  /// concurrent rotation — rather than theft, and a FRESH child is minted
  /// and returned rather than revoking the family.
  ///
  /// Deliberately holds no reference to what this token was replaced
  /// BY: an earlier revision of this column (`replacedByToken`) stored the
  /// raw replacement token itself, so that a grace-window replay could hand
  /// back the exact same child. Review found that traded away the one
  /// property hashing `tokenHash` exists to provide — a database-read
  /// compromise (backup leak, injection, insider) would yield a directly
  /// usable bearer token, live for the row's full multi-day TTL, for every
  /// ordinary (non-replayed) rotation, not just the rare theft case. Minting
  /// a fresh child per grace-window replay instead keeps this table
  /// hash-only again: nothing derived from a live secret is ever persisted
  /// here in reversible form.
  supersededAt DateTime?

  /// Count of grace-window replays of THIS parent that have already been
  /// allowed through (minted a fresh child). Incremented atomically —
  /// `UPDATE ... SET graceReplayCount = graceReplayCount + 1 WHERE id = ?
  /// AND graceReplayCount < cap` — by the same conditional-update pattern
  /// `markUsed` already uses, so concurrent replays cannot all read the
  /// same pre-increment value and all pass.
  ///
  /// This is not a rate limit bolted on after the fact — it IS the theft
  /// signal, on the same footing as the time window: a genuine double-tap
  /// or duplicate tab produces one or two replays, a mobile retry chain
  /// maybe three. Someone firing far more than that inside the same few
  /// seconds isn't retrying, they're working the window — and the correct
  /// response to that is exactly the theft response (family revoke), not a
  /// 429. See `RefreshService.REFRESH_GRACE_REPLAY_CAP` for the chosen cap
  /// and the reasoning above stated in full.
  graceReplayCount Int @default(0)

  user LibUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  at          DateTime @default(now())

  @@index([orgId, at])
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  key            String
  endpoint       String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([orgId, key])
  @@index([createdAt])
}

enum AuthorRole {
  AUTHOR
  EDITOR
  TRANSLATOR
}

enum CopyCondition {
  NEW
  GOOD
  FAIR
  POOR
}

enum CopyStatus {
  AVAILABLE
  ISSUED
  RESERVED_SHELF
  IN_TRANSIT
  LOST
  DAMAGED
  WITHDRAWN
}

model Title {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  isbn13        String?
  isbn10        String?
  title         String
  subtitle      String?
  publisher     String?
  publishedYear Int?
  edition       String?
  language      String   @default("en")
  callNumber    String?
  coverUrl      String?
  description   String?
  pageCount     Int?

  /// What a parent is asked to pay when a copy of this book is lost — today's
  /// cost to buy it again, NOT what the school once paid. `Copy.acquisitionCost`
  /// is that other number: per physical copy, from the bill, historic and
  /// immutable. The two must never be conflated in a UI or backfilled into each
  /// other; the register column is labelled "Price paid" and this one "Cost to
  /// replace" precisely so a librarian cannot read one as the other.
  ///
  /// Title-level, not per copy: a replacement is bought at today's market
  /// price, which is one number per book. Where a title's editions genuinely
  /// differ, the loss screen takes a per-loss override (P3) rather than making
  /// every school maintain a price on every physical copy forever.
  ///
  /// NULLABLE, and that is a designed state, not a gap. A school onboarding
  /// four thousand existing books starts with this unset everywhere, so a
  /// missing price must never block RECORDING a loss — reporting a loss is what
  /// freezes the daily late charge (§2.4), and blocking the report to collect a
  /// catalogue field would punish the child who owned up. Only the money is
  /// deferred: the librarian types an amount at the counter, or later.
  ///
  /// Seeded one-way from the add-copies path (`copies.service.ts#add`): the
  /// price paid for a book being bought today is also, on that day, what it
  /// costs to replace. It is written ONLY when this column is still null, by a
  /// conditional UPDATE rather than a read-then-write, and never overwrites a
  /// number a librarian has since set.
  ///
  /// Not visible to a MEMBER. `search.service.ts` and `titles.service.ts#get`
  /// strip it for student callers: the only party that tells a child what they
  /// owe is the library, after a librarian has confirmed the loss.
  ///
  /// A `>= 0` CHECK lives in the database (`Title_replacementPrice_nonnegative`),
  /// not only in the DTO — a negative value would credit a parent for losing a
  /// book, and no path, including a future import or a hand-written UPDATE,
  /// should be able to produce one.
  replacementPrice Decimal? @db.Decimal(10, 2)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Generated column, added by hand in the catalogue migration (Prisma
  /// cannot express `GENERATED ALWAYS AS (...) STORED`). `Unsupported` here
  /// only tells Prisma to tolerate the column's existence in introspection;
  /// no application code writes to it.
  searchVector Unsupported("tsvector")?

  org        LibraryOrg      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authors    TitleAuthor[]
  categories TitleCategory[]
  copies     Copy[]
  reservations Reservation[]

  @@index([orgId])
  @@index([orgId, callNumber])
}

model Author {
  id       String @id @default(uuid()) @db.Uuid
  orgId    String @db.Uuid
  name     String
  sortName String

  org    LibraryOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  titles TitleAuthor[]

  @@unique([orgId, sortName])
  @@index([orgId])
}

/// Carries no orgId of its own — reachable only through Title (RLS-scoped)
/// and Author (RLS-scoped), whose foreign keys both cascade from here. See
/// the org_isolation policy comment in the catalogue_rls migration and the
/// RLS_ALLOW_LIST comment in rls-audit.ts for why this is allow-listed
/// rather than unprotected.
model TitleAuthor {
  titleId  String     @db.Uuid
  authorId String     @db.Uuid
  role     AuthorRole @default(AUTHOR)

  title  Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([titleId, authorId, role])
  @@index([authorId])
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  orgId    String  @db.Uuid
  name     String
  parentId String? @db.Uuid

  org      LibraryOrg      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]      @relation("CategoryTree")
  titles   TitleCategory[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([parentId])
}

/// Carries no orgId of its own — see TitleAuthor's comment above; same
/// indirection through Title and Category.
model TitleCategory {
  titleId    String @db.Uuid
  categoryId String @db.Uuid

  title    Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([titleId, categoryId])
  @@index([categoryId])
}

model Copy {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @db.Uuid
  titleId         String        @db.Uuid
  branchId        String        @db.Uuid
  /// The number written inside the front cover, by hand, permanently. It is
  /// unique per PHYSICAL COPY and is the only identifier this service uses —
  /// there is deliberately no barcode, because a school should not have to buy
  /// and maintain scanner hardware to lend a book. Sequential per library, which
  /// is what lets stock verification accept a shelf as a RANGE.
  ///
  /// Never reused. A copy written off as lost keeps its number for good and a
  /// replacement is entered under the next one, so the register reads as a
  /// history rather than a stock list — which is what an auditor checks.
  accessionNumber String
  shelf           String?
  condition       CopyCondition @default(GOOD)
  acquiredAt      DateTime?
  acquisitionCost Decimal?      @db.Decimal(10, 2)
  status          CopyStatus    @default(AVAILABLE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  org    LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: deleting a title that still has physical copies
  /// is a data-loss bug and must fail loudly, not silently vanish stock.
  title  Title      @relation(fields: [titleId], references: [id], onDelete: Restrict)
  /// Restrict, not Cascade: same reasoning for a branch that still holds
  /// stock.
  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  issues Issue[]
  reservations Reservation[]     @relation("ReservationReadyCopy")
  lostReports  LostReport[]

  @@unique([orgId, accessionNumber])
  @@index([titleId, status])
  @@index([orgId, branchId, status])
  /// FK index — see 20260814090000_index_foreign_keys.
  @@index([branchId])
}

enum IssueStatus {
  ACTIVE
  RETURNED
  LOST
}

/// Includes `EXPIRED` — restored after review correction (batch report,
/// review finding 2). Trap 7 (docs/superpowers/LIBRARY-TRAPS.md) forbids a
/// status only a SCHEDULER can flip, because a missed cron then corrupts
/// state. `EXPIRED` here is not that: it is set by the next user-triggered
/// action that touches this title's holds (the sweep that runs when the
/// next copy is returned, promoting/lapsing the queue), never by a clock in
/// the absence of any request. `expiresAt` stays the source of truth for
/// "has this hold lapsed yet" before that sweep runs — a hold can be
/// PAST expiresAt and still show status READY until something touches it.
/// Storing the terminal outcome distinctly from CANCELLED matters for
/// reporting: without it, "how many holds went unclaimed" (EXPIRED) is
/// indistinguishable from "how many holds a member cancelled" (CANCELLED)
/// once both collapse into the same value. See
/// packages/library-db/src/schema-shape.spec.ts's `FORBIDDEN_VALUE_EXCEPTIONS`
/// for the reviewable, by-name exception this value is allow-listed under.
enum ReservationStatus {
  PENDING
  READY
  COLLECTED
  EXPIRED
  CANCELLED
}

enum FineKind {
  OVERDUE
  DAMAGE
  LOST
  OTHER
}

/// Deliberately UNCHANGED by P3, and that is a decision rather than an
/// oversight. Adding a value to a money enum that is already shipped silently
/// changes the meaning of every sum built on it: a `PENDING` for an
/// unconfirmed self-report would start counting a nine-year-old's tap as money
/// owed in `listFines`, `dayReport.finesAccrued`, the console's "still owed"
/// tile and P4's `/me/dues`, unless every one of those were found and filtered
/// — which is trap 9 on the one surface where being wrong reaches a parent.
/// An unconfirmed loss therefore has NO Fine row at all; the frozen figure
/// lives on `LostReport` until a librarian confirms. Likewise no `REFUND` or
/// `CREDIT`: a book found after a parent paid is recorded as a refund owed at
/// the desk (see `LostReport`), not as a new money state.
enum FineStatus {
  OPEN
  PAID
  WAIVED
  PARTIAL
}

/// Where the amount on a `LOST` fine came from. Mirrors
/// `apps/library-api/src/common/replacement-price.ts`'s resolver, MINUS its
/// `UNPRICED` case — an unpriced loss creates no fine at all (a ₹0 fine reads
/// as "nothing owed" to every total and to P5's No Dues certificate), so that
/// value could never appear on a row and does not belong in the enum.
///
/// This is snapshotted, never re-derived. The bill handed to a parent in
/// August must still read the same next March, even after someone edits that
/// book's price in the catalogue.
enum FineAmountSource {
  /// A librarian typed this amount for this specific loss, looking at the book.
  TYPED
  /// `Title.replacementPrice` — today's cost to buy the book again.
  TITLE_PRICE
  /// `Copy.acquisitionCost` — historic, what the school paid. Must always be
  /// presented WITH its age ("the library paid ₹45 when this copy was bought"),
  /// never bare.
  PURCHASE_COST
}

/// How money that was collected actually crossed the counter. Cash and UPI are
/// what an Indian school desk sees; `OTHER` requires a note.
///
/// Three columns on `Fine`, not a `FinePayment` table: the spec defers the
/// payment-provider ledger, and what keeps this honest rather than a
/// half-ledger is that P3 records payment IN FULL ONLY. A counter taking ₹100
/// today and ₹199 next week genuinely needs a payments table — one method
/// column cannot truthfully describe two payments — so that is not offered.
enum PaymentMethod {
  CASH
  UPI
  OTHER
}

/// Why a fine was let off. A CODE rather than free text because the collections
/// dashboard asks "where did each rupee go", and four hundred unique strings
/// cannot answer it.
///
/// The first two are MECHANICAL: the school lost nothing, so they must be
/// excluded from the "let off" money figure. Counting them would inflate what
/// looks like the school's generosity with book-keeping.
enum WaiverReason {
  /// The original copy turned up. Cleared in kind, not forgiven.
  BOOK_FOUND
  /// The family brought a physical replacement. Cleared in kind, not forgiven.
  REPLACED_IN_KIND
  /// Out of print, nothing to replace it with. Genuinely written off.
  WRITTEN_OFF_UNREPLACEABLE
  /// The family cannot pay. Genuinely forgiven.
  HARDSHIP
  /// We charged the wrong person, or charged for our own mistake. The honest
  /// home for "I typed the wrong number and billed the wrong child", which has
  /// no route at all today.
  LIBRARY_ERROR
  /// A deliberate gift, with a reason in the note.
  GOODWILL
}

/// Every value here is set by a USER ACTION, never by a clock — trap 7. In
/// order: REPORTED by a member self-reporting; CONFIRMED by a librarian
/// confirming (or set at creation when a librarian reports it themselves, since
/// the adult is already in the loop); REJECTED by a librarian when the book
/// turns up before confirmation; the three SETTLED_/WRITTEN_OFF values by the
/// corresponding settlement action; FOUND when the original copy reappears.
///
/// No value in this enum is time-derived, so `schema-shape.spec.ts` needs no
/// new `FORBIDDEN_VALUE_EXCEPTIONS` entry.
/// What was decided when a copy turned up AFTER the family had already paid.
/// Set by a user action, never by a clock.
enum TurnedUpOutcome {
  /// The book goes back on the shelf and the school owes the family what they
  /// paid, until a librarian settles it at the desk.
  REFUND_OWED
  /// They paid for it, so it is theirs. The copy stays retired.
  FAMILY_KEEPS
}

enum LostReportStatus {
  /// Self-reported, awaiting a librarian. The late charge is ALREADY frozen and
  /// the copy is already out of circulation — only the money waits.
  REPORTED
  /// A librarian has seen it. This is the point at which fines exist.
  CONFIRMED
  /// The book turned up before confirmation; the world is restored exactly.
  REJECTED
  SETTLED_PAID
  /// The family brought a replacement copy.
  SETTLED_IN_KIND
  WRITTEN_OFF
  /// The original copy reappeared after confirmation.
  FOUND
}

/// Keyed on (orgId, memberType) — MemberType stays a fixed enum (see
/// OrgTheme.memberTypeLabels) precisely so a policy can be looked up by it
/// without a join. Field names mirror apps/library-api's pure policy engine
/// (`modules/circulation/internal/policy.ts`'s `Policy` interface) so a
/// future Prisma-backed caller needs no translation layer.
model CirculationPolicy {
  id                 String     @id @default(uuid()) @db.Uuid
  orgId              String     @db.Uuid
  /// null = org default, used when no row exists for the caller's specific
  /// branch. `circulation/internal/policy-loader.ts`'s `loadPolicy` always
  /// tries the branch-specific row first, falling back to this one.
  ///
  /// True uniqueness — "at most one branch-specific row per (orgId,
  /// branchId, memberType), AND at most one org-default row per (orgId,
  /// memberType)" — is NOT expressible as a single Prisma `@@unique` here:
  /// Postgres unique indexes treat NULL as distinct from NULL, so a naive
  /// `@@unique([orgId, branchId, memberType])` would silently permit two
  /// org-default (branchId NULL) rows to coexist for the same memberType —
  /// the same NULL-is-not-equal-to-NULL gotcha this project already works
  /// around for RLS (NULLIF, LIBRARY-TRAPS.md #1). Enforced instead by two
  /// partial unique indexes in the branch-scope migration — the same
  /// technique `loan_one_active_per_copy` already uses for a different
  /// NULL-bearing column (see that migration's own comment).
  branchId           String?    @db.Uuid
  memberType         MemberType
  maxBooks           Int
  issueDays          Int
  renewLimit         Int
  renewDays          Int
  finePerDay         Decimal    @db.Decimal(10, 2)
  /// Days past dueAt with zero fine before billing starts.
  graceDays          Int
  /// null = uncapped.
  maxFine            Decimal?   @db.Decimal(10, 2)
  maxReservations    Int
  reservedShelfDays  Int
  /// null = no outstanding-fine gate on new issues.
  maxOutstandingFine Decimal?   @db.Decimal(10, 2)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Restrict, not SetNull: a branch deletion that silently demoted a
  /// branch-specific policy to an org default would also risk colliding with
  /// the partial unique index enforcing "one org default per memberType" —
  /// confusing either way. A branch with a configured policy must not vanish
  /// out from under it (same reasoning as Copy.branchId's Restrict).
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([orgId, branchId, memberType])
  @@index([orgId])
  @@index([branchId])
}

model Issue {
  id               String     @id @default(uuid()) @db.Uuid
  orgId            String     @db.Uuid
  copyId           String     @db.Uuid
  /// Denormalized from `Copy.branchId` at issue time (LoansService.issue) so
  /// "which branch is this loan at" is answerable directly, without a join
  /// through Copy, on every branch-scoped read (BranchScopeGuard,
  /// listOverdue, dayReport). NOT NULL: unlike Reservation.branchId, an Issue always
  /// has a copy from the moment it exists, so there is no "not yet known"
  /// state to represent.
  branchId         String     @db.Uuid
  memberId         String     @db.Uuid
  issuedAt         DateTime   @default(now())
  dueAt            DateTime
  /// null while the issue is open. LATE is never stored — see IssueStatus.
  returnedAt       DateTime?
  renewCount       Int        @default(0)
  issuedByUserId   String?    @db.Uuid
  returnedByUserId String?    @db.Uuid
  status           IssueStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  org        LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Restrict: a copy with loan history must not vanish out from under it.
  copy       Copy       @relation(fields: [copyId], references: [id], onDelete: Restrict)
  /// Restrict, same reasoning as `copy` above — a branch with loan history
  /// must not vanish out from under it.
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  issuedBy   LibUser?   @relation("IssueIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  returnedBy LibUser?   @relation("IssueReturnedBy", fields: [returnedByUserId], references: [id], onDelete: SetNull)
  fines      Fine[]
  lostReports LostReport[]

  @@index([orgId])
  @@index([orgId, branchId])
  /// FK indexes — see 20260814090000_index_foreign_keys.
  @@index([copyId])
  @@index([memberId])
  @@index([branchId])
  @@index([issuedByUserId])
  @@index([returnedByUserId])
}

/// Keyed on titleId, not copyId: a member holds a place in line for a TITLE
/// (any available copy will do), and only gets tied to a specific copy
/// (readyCopyId) once one is pulled for them.
model Reservation {
  id            String     @id @default(uuid()) @db.Uuid
  orgId         String     @db.Uuid
  titleId       String     @db.Uuid
  /// Set only when this hold is promoted — the branch of the copy pulled for
  /// it (mirrors readyCopyId/readyAt, set together in
  /// LoansService.promoteOrRelease). A still-PENDING hold has no branch: it
  /// is a place in line for a Title, fillable by any branch's copy, so this
  /// stays null until promotion — unlike Issue.branchId, which is set at
  /// issue and therefore NOT NULL.
  branchId      String?    @db.Uuid
  memberId      String     @db.Uuid
  /// Lower = earlier in the queue.
  queuePosition Int
  status        ReservationStatus @default(PENDING)
  readyCopyId   String?    @db.Uuid
  readyAt       DateTime?
  /// Meaningful ONLY when status is READY: the hold-shelf deadline, set at
  /// promotion time to `holdShelfExpiry(policy, promotedAt)`
  /// (apps/library-api's policy.ts) — computed from the promoted member's
  /// own CirculationPolicy, not the returning member's. Past this deadline
  /// (still READY in the stored row), the hold reads as EXPIRED at query
  /// time via `policy.ts`'s `holdState` — never written by a scheduler
  /// (trap 7): the terminal EXPIRED row write happens only inside the next
  /// RETURN for this title's `promoteOrRelease` sweep (loans.service.ts), a
  /// user-triggered action, never a timer.
  ///
  /// A PENDING hold has no real deadline yet (nothing has been promoted for
  /// it, so there is nothing to expire), but this column is NOT NULL — no
  /// natural "no deadline" value exists for a DateTime, and adding a
  /// nullable column (or a queue-timeout feature this phase doesn't have)
  /// for a value nothing reads is not worth the complexity. Task 8 already
  /// established the convention informally (see its e2e's `FAR_FUTURE`
  /// fixture); Task 9 formalizes it here and in code:
  /// `holds.service.ts`'s `PENDING_HOLD_SENTINEL_YEARS`/
  /// `pendingHoldSentinel()` is the ONE place that value is produced, kept
  /// far enough out it can never be mistaken for "expiring soon" by a naive
  /// read, and `holdState` never reinterprets a PENDING hold by `expiresAt`
  /// regardless of its value — only READY ever is.
  expiresAt     DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  org       LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title     Title      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  readyCopy Copy?      @relation("ReservationReadyCopy", fields: [readyCopyId], references: [id], onDelete: SetNull)
  /// Restrict, same reasoning as Issue.branch — a branch a hold was ever
  /// promoted onto must not vanish out from under that history.
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([orgId, branchId])
  /// FK indexes — see 20260814090000_index_foreign_keys.
  @@index([titleId])
  @@index([memberId])
  @@index([branchId])
  @@index([readyCopyId])
}

model Fine {
  id             String     @id @default(uuid()) @db.Uuid
  orgId          String     @db.Uuid
  memberId       String     @db.Uuid
  issueId        String?    @db.Uuid
  kind           FineKind
  status         FineStatus @default(OPEN)
  amount         Decimal    @db.Decimal(10, 2)
  paidAmount     Decimal    @default(0) @db.Decimal(10, 2)
  reason         String?
  /// Task 10: set together, only when `status` becomes WAIVED. `waivedAmount`
  /// is the amount actually forgiven (may be less than `amount -
  /// paidAmount` for a partial waiver — see fines.service.ts's `waive`);
  /// never re-derived from `amount`/`paidAmount` after the fact, since
  /// those can still be read independently for "what was originally owed"
  /// reporting.
  waivedByUserId String?    @db.Uuid
  waivedAmount   Decimal?   @db.Decimal(10, 2)
  waivedReason   String?
  waivedAt       DateTime?

  /// P3. A CODE alongside the existing free-text `waivedReason`, so the
  /// collections dashboard can answer "where did each rupee go" — and so the
  /// two MECHANICAL reasons (BOOK_FOUND, REPLACED_IN_KIND) can be excluded from
  /// the "let off" total, since the school lost nothing in either case. Set
  /// together with the other `waived*` fields; null on every fine waived before
  /// P3 and on every fine that was never waived.
  waiverReasonCode WaiverReason?

  /// Where this amount came from — snapshotted at the moment the charge was
  /// raised, NEVER a live join back to `Title.replacementPrice`. Editing a
  /// book's catalogue price next term must not silently rewrite a bill already
  /// handed to a parent.
  ///
  /// Null on an `OVERDUE` fine, which is computed from the circulation policy
  /// rather than resolved from a price, and on every fine created before P3.
  /// Non-null on a `LOST` fine.
  amountSource     FineAmountSource?

  /// The human who TYPED this amount — set only when `amountSource` is `TYPED`,
  /// and null for `TITLE_PRICE`/`PURCHASE_COST`, where nobody typed anything and
  /// claiming a person did would be a lie an auditor could read. "Which
  /// librarian ran the flow" is answered by `LostReport.confirmedByUserId`; this
  /// column answers the narrower and more consequential "who chose this number".
  ///
  /// SetNull, matching `waivedBy`: losing who typed it must not block deleting a
  /// departed user, and the amount itself survives regardless.
  amountSetByUserId String?   @db.Uuid

  /// There is deliberately no `amountSetAt`: the amount is fixed when the fine
  /// row is created and never edited afterwards, so `createdAt` already IS that
  /// timestamp, and a second column could only ever disagree with it.

  /// P3, recorded not moved. Money crossing the counter is written down here;
  /// no provider, no ledger, no partial history — see `PaymentMethod`.
  paidAt         DateTime?
  paidByUserId   String?    @db.Uuid
  paidMethod     PaymentMethod?
  /// Required by convention when `paidMethod` is OTHER; also the place a
  /// receipt/slip number goes.
  paymentNote    String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  org      LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade (fixed per review finding 4): loanId is nullable
  /// and kind includes DAMAGE/OTHER, so a member can carry an OPEN fine with
  /// no Issue behind it at all. Cascade would let deleting that member
  /// silently destroy a real financial record — money genuinely owed —
  /// exactly the "fails quietly" failure mode Copy.title's Restrict already
  /// exists to prevent for physical stock.
  member   Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  issue    Issue?     @relation(fields: [issueId], references: [id], onDelete: SetNull)
  /// SetNull, not Restrict: the waiving LibUser leaving/being deleted must
  /// not block user deletion, and losing "who waived it" is acceptable —
  /// the money itself (waivedAmount/waivedReason) stays on the row either way.
  waivedBy LibUser?   @relation("FineWaivedBy", fields: [waivedByUserId], references: [id], onDelete: SetNull)
  /// SetNull, same reasoning as `waivedBy` — see `amountSetByUserId`.
  amountSetBy LibUser? @relation("FineAmountSetBy", fields: [amountSetByUserId], references: [id], onDelete: SetNull)
  /// SetNull, same reasoning: who took the cash is worth keeping, but must
  /// never block deleting a departed user, and the payment itself survives.
  paidBy   LibUser?   @relation("FinePaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)

  @@index([orgId])
  /// Same unindexed-FK reasoning as LostReport: deleting a LibUser must not
  /// scan every fine the school has ever raised.
  @@index([amountSetByUserId])
  @@index([paidByUserId])
  @@index([memberId])
  @@index([issueId])
  @@index([waivedByUserId])
}

/// One physical book reported lost, and everything that happened to it after.
///
/// This exists as its own table rather than as extra columns on `Issue` for two
/// reasons. First, a loss found during stock verification has NO issue and NO
/// member at all — nobody had it, it is simply not on the shelf — and the
/// alternative to modelling that is a librarian inventing a fake issue to a
/// child in order to record a missing book. Second, the report is the thing
/// that must survive every later reversal: a rejected report, a found book, a
/// refunded payment all stay readable afterwards, which is what makes the
/// register a history rather than a stock list.
///
/// It is also the ONLY home for the frozen late charge between a child's
/// self-report and a librarian's confirmation, because no `Fine` row exists yet
/// in that window (see `FineStatus`).
model LostReport {
  id       String @id @default(uuid()) @db.Uuid
  orgId    String @db.Uuid

  /// Restrict: a copy with a loss on its record must not vanish out from under
  /// it — the same reasoning as `Issue.copy`.
  copyId   String @db.Uuid

  /// Denormalized from the copy at report time, exactly as `Issue.branchId` is,
  /// so "which branch was this lost at" is answerable without a join on every
  /// branch-scoped read. NOT NULL: a copy always has a branch, including a
  /// stock-take loss.
  branchId String @db.Uuid

  /// NULL for a loss found at stock verification: nobody had it. Non-null for
  /// every loss that came off an issue. A database CHECK ties this to `issueId`
  /// so the two can never disagree — see the migration's
  /// `LostReport_member_and_issue_together`.
  memberId String? @db.Uuid
  /// NULL for a stock-take loss, for the same reason. Restrict where present:
  /// the issue is the history this report is about.
  issueId  String? @db.Uuid

  /// The account that reported it. A self-reporting student IS a `LibUser` with
  /// role MEMBER, so this is the same FK either way; `selfReported` is what
  /// distinguishes them, because the ROLE on the account can change later and
  /// the fact of who reported it cannot.
  reportedByUserId String?  @db.Uuid
  /// True when the holder reported their own loss from the app. Load-bearing:
  /// a self-report creates no fines and waits for confirmation, a
  /// librarian-reported loss is created already CONFIRMED because the adult is
  /// standing at the counter having the conversation.
  selfReported     Boolean  @default(false)
  reportedAt       DateTime @default(now())

  status LostReportStatus

  confirmedAt       DateTime?
  confirmedByUserId String?   @db.Uuid
  /// Why a librarian rejected the report — required when status is REJECTED.
  rejectedReason    String?

  /// The late charge as it stood at the MOMENT OF REPORT, frozen. Not
  /// recomputed later: that is the whole incentive — owning up stops the clock,
  /// and a number that kept moving afterwards would make the report pointless.
  /// Null only when fines are off for this member type, so nothing accrued.
  ///
  /// After confirmation an `OVERDUE` Fine carries this same figure. They are
  /// written together, in one transaction, from one value, and neither is
  /// updated independently afterwards: this column is the RECORD of what was
  /// frozen, the fine is the BILL.
  frozenLateAmount Decimal? @db.Decimal(10, 2)

  /// What a replacement costs, resolved at confirmation. NULL means UNPRICED —
  /// a legitimate, visible state: the loss is recorded, the copy is out of
  /// circulation, the late charge is frozen, and the money is deferred until a
  /// human types a number. It must never be coerced to 0.
  replacementAmount Decimal? @db.Decimal(10, 2)
  /// Where `replacementAmount` came from. Null exactly when it is null.
  priceSource       FineAmountSource?

  /// Settlement. `settledAt`/`settledByUserId` are set for every terminal
  /// outcome; which one it was is carried by `status`.
  settledAt        DateTime?
  settledByUserId  String?   @db.Uuid
  /// For a write-off: the human who actually authorised it, in words — "Principal
  /// Mrs Rao, note dated 12 Aug". Free text on purpose. There is no principal
  /// ROLE in this service, and inventing one to gate this would, in a school
  /// where the librarian is the only account, produce either a due that can
  /// never be closed or a fake "paid" entry. Recorded approval that is auditable
  /// beats a gate that gets routed around.
  approvedByNote   String?

  /// Set when the original copy turns up AFTER the family has already paid.
  /// The school then has both the money and the book, and software cannot send
  /// money back — so this records the OBLIGATION and keeps it on screen until a
  /// librarian settles it at the desk and ticks `refundedAt`.
  ///
  /// Null means no refund is owed: either nothing was ever paid, or the family
  /// chose to keep the book they paid for. `FineStatus` gains no REFUND/CREDIT
  /// value for this — see the migration's own comment.
  /// The decision itself, which is ALSO the re-entry guard: without state of
  /// its own, "the family keeps it" left nothing behind and could be followed
  /// by "we owe them a refund", with both sticking.
  turnedUpAt       DateTime?
  turnedUpOutcome  TurnedUpOutcome?

  refundOwedAmount Decimal?  @db.Decimal(10, 2)
  refundedAt       DateTime?
  refundedByUserId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  copy       Copy       @relation(fields: [copyId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member     Member?    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  issue      Issue?     @relation(fields: [issueId], references: [id], onDelete: Restrict)
  reportedBy LibUser?   @relation("LostReportReportedBy", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  confirmedBy LibUser?  @relation("LostReportConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  settledBy  LibUser?   @relation("LostReportSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)
  refundedBy LibUser?   @relation("LostReportRefundedBy", fields: [refundedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, branchId, status])
  @@index([orgId, memberId])

  /// One per FK column. Postgres checks referencing rows when a PARENT is
  /// deleted, and a composite index led by orgId cannot serve a lookup by
  /// copyId alone — without these, deleting a Copy/Member/Issue/Branch/LibUser
  /// sequentially scans this table. Measured: their absence took the e2e
  /// authz-matrix suite from 17s to 823s.
  @@index([copyId])
  @@index([issueId])
  @@index([memberId])
  @@index([branchId])
  @@index([reportedByUserId])
  @@index([confirmedByUserId])
  @@index([settledByUserId])
  @@index([refundedByUserId])
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  INAPP
}

/// The durable record of an outbound notification. Task 8's return flow
/// writes a `HOLD_READY` row here on hold promotion — nothing drains this
/// table until Phase 4's outbox drain cron exists (see the no-scheduler rule,
/// §6.3 of the design doc: a missed drain delays a message, it can never
/// corrupt an Issue/Reservation/Fine, because none of THEIR state depends on this
/// table ever being read). `templateKey` is a plain string, not an enum,
/// because `NotificationTemplate` (the model that would own that
/// enumeration) is itself a Phase 4 table — pinning the key values into this
/// schema before that model exists would be premature.
model NotificationOutbox {
  id           String              @id @default(uuid()) @db.Uuid
  orgId        String              @db.Uuid
  channel      NotificationChannel
  templateKey  String
  /// Recipient identifier — a memberId, phone, or email depending on
  /// `channel`; Phase 4's channel adapters decide how to resolve it.
  to           String
  payload      Json                @default("{}")
  scheduledFor DateTime            @default(now())
  sentAt       DateTime?
  attempts     Int                 @default(0)
  lastError    String?
  providerRef  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// A partial index on `scheduledFor WHERE sentAt IS NULL` — the actual hot
  /// read path for a future drain worker (Phase 4) — is added by hand in the
  /// migration, not declared here: Prisma's schema DSL cannot express a
  /// partial index. Mirrors the `loan_one_active_per_copy` / `hold_title_queue`
  /// partial indexes already hand-added in the circulation migration, which
  /// are likewise absent from their models' `@@index` lists above.

  @@index([orgId, sentAt])
}


// ---------------------------------------------------------------------------
// The library period (Phase 2c)
//
// A class comes to the library in a timetabled period. The library holds only
// so many classes at once, and the librarian wants to know who actually came.
// ---------------------------------------------------------------------------

/// Per-library settings a librarian can change without a deploy.
///
/// One row per org, created lazily on first read. Kept separate from
/// `LibraryOrg` so that adding a setting is not a migration on the table every
/// request resolves a tenant against.
model LibrarySettings {
  id       String @id @default(uuid()) @db.Uuid
  orgId    String @unique @db.Uuid

  /// How many classes the room holds at once. Assigning one more to the same
  /// period is refused when the timetable is set — not discovered when eighty
  /// children arrive.
  concurrentClassCapacity Int @default(2)

  /// Attendance is recorded at all. Off is a legitimate answer: if the class
  /// teacher already marks period attendance elsewhere, doing it again here is
  /// duplicate work on the busiest screen in the product.
  recordAttendance Boolean @default(true)

  /// Charge late fees to students. Off by default — most schools charge
  /// children nothing, and a default that quietly bills a ten-year-old is the
  /// wrong default.
  chargeStudentFines Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// A recurring slot in the school timetable: "6-B has the library on Tuesday,
/// period 3".
model LibraryPeriod {
  id        String @id @default(uuid()) @db.Uuid
  orgId     String @db.Uuid
  branchId  String @db.Uuid

  /// 1 = Monday .. 7 = Sunday (ISO), so ordering and arithmetic behave.
  weekday   Int
  /// The school's own period number, not a clock time — schools move bells.
  period    Int
  /// A plain class label the librarian types (`6-B`). Deliberately NOT a
  /// foreign key to Sckools yet: this phase must work before the two services
  /// are linked, and the sync can populate it later.
  classRef  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    LibraryOrg  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  visits ClassVisit[]

  /// One class cannot be booked into the same slot twice. How MANY classes may
  /// share a slot is a setting, checked in the service — a unique index cannot
  /// express "at most N".
  @@unique([branchId, weekday, period, classRef])
  @@index([orgId, branchId, weekday, period])
}

/// One actual visit by one class on one day.
model ClassVisit {
  id        String    @id @default(uuid()) @db.Uuid
  orgId     String    @db.Uuid
  branchId  String    @db.Uuid
  periodId  String?   @db.Uuid
  classRef  String
  /// The library's own day, in the org timezone.
  date      DateTime  @db.Date
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  org        LibraryOrg       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  period     LibraryPeriod?   @relation(fields: [periodId], references: [id], onDelete: SetNull)
  attendance VisitAttendance[]

  /// One visit per class per day PER BRANCH. Omitting branchId here let two
  /// branches that each have a "6-B" collide: `openVisit` would hand branch A's
  /// visit to branch B, and both rosters would merge.
  @@unique([orgId, branchId, classRef, date])
  @@index([orgId, branchId, date])
  @@index([branchId])
  @@index([periodId])
}

/// Who was present at a visit.
model VisitAttendance {
  id       String  @id @default(uuid()) @db.Uuid
  orgId    String  @db.Uuid
  visitId  String  @db.Uuid
  memberId String  @db.Uuid

  /// True when a circulation transaction put this row here rather than a
  /// person ticking a box. Issuing or returning a book PROVES the child was
  /// present, so the librarian only ticks the few who came and browsed —
  /// forty ticks become about five. Keeping the distinction also separates
  /// "attended but borrowed nothing" from "was not here", which is exactly the
  /// signal reading promotion needs.
  auto     Boolean @default(false)

  markedAt DateTime @default(now())

  org    LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  visit  ClassVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  member Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// Present is present — a second scan must not create a second row, and the
  /// database is what enforces that under a double-tap, not the handler.
  @@unique([visitId, memberId])
  @@index([orgId, memberId])
  @@index([memberId])
}
