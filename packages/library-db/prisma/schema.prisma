generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("LIBRARY_DATABASE_URL")
  directUrl = env("LIBRARY_DIRECT_URL")
}

enum Plan {
  FREE
  MINI
  PRO
}

enum OrgStatus {
  SETUP
  LIVE
  SUSPENDED
}

enum LibDomainType {
  SUBDOMAIN
  CUSTOM
}

enum LibDomainStatus {
  PENDING
  LIVE
  ERROR
}

/// Library logins. MemberType drives circulation policy and is deliberately a
/// separate axis — a TEACHER member has no administrative reach.
enum LibRole {
  ORG_OWNER
  LIBRARIAN
  ASSISTANT
  MEMBER
}

enum MemberType {
  STUDENT
  TEACHER
  EXTERNAL
}

enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model LibraryOrg {
  id           String    @id @default(uuid()) @db.Uuid
  slug         String    @unique
  name         String
  plan         Plan      @default(FREE)
  status       OrgStatus @default(SETUP)
  currency     String    @default("INR")
  timezone     String    @default("Asia/Kolkata")
  locale       String    @default("en-IN")
  contactEmail String?
  contactPhone String?

  /// The Sckools `School.id` this library belongs to, when the services are
  /// linked. Null until then — the library runs standalone and must keep
  /// working that way.
  ///
  /// Unique because the merge plan is one LibraryOrg per School (§13). Nullable
  /// uniqueness is safe in Postgres: many NULLs coexist, so unlinked orgs do
  /// not collide with each other.
  ///
  /// Added BEFORE the library ever held real data. The same column added later
  /// is a migration against live rows on a table every request touches — this
  /// costs nothing now and is the cheapest insurance in the schema.
  schoolId     String?   @unique @db.Uuid

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  domains    LibraryDomain[]
  theme      OrgTheme?
  branches   Branch[]
  users      LibUser[]
  members    Member[]
  overrides  PlanOverride[]
  titles     Title[]
  authors    Author[]
  categories Category[]
  copies     Copy[]
  policies   CirculationPolicy[]
  issues     Issue[]
  holds      Hold[]
  fines      Fine[]
  outbox     NotificationOutbox[]
}

model LibraryDomain {
  id        String          @id @default(uuid()) @db.Uuid
  orgId     String          @db.Uuid
  hostname  String          @unique
  type      LibDomainType   @default(SUBDOMAIN)
  status    LibDomainStatus @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model OrgTheme {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @unique @db.Uuid
  logoUrl          String?
  primaryColor     String   @default("#2E3A87")
  accentColor      String   @default("#8F671D")
  receiptHeader    String?
  receiptFooter    String?
  /// Per-org display labels for the fixed MemberType enum, e.g.
  /// {"EXTERNAL":"Alumni"}. The enum stays fixed because CirculationPolicy is
  /// keyed on it; only the label is configurable.
  memberTypeLabels Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model PlanOverride {
  id      String  @id @default(uuid()) @db.Uuid
  orgId   String  @db.Uuid
  key     String
  enabled Boolean

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId])
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  code      String
  address   String?
  phone     String?
  openTime  String?
  closeTime String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      LibraryOrg          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members  Member[]
  copies   Copy[]
  issues   Issue[]
  holds    Hold[]
  policies CirculationPolicy[]

  @@unique([orgId, code])
  @@index([orgId])
}

model LibUser {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @db.Uuid
  email          String?
  phone          String?
  passwordHash   String
  role           LibRole
  branchIds      String[]  @db.Uuid
  memberId       String?   @unique @db.Uuid
  active         Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org           LibraryOrg     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member        Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  refresh       RefreshToken[]
  issuesMade    Issue[]         @relation("IssueIssuedBy")
  issuesTakenBack Issue[]         @relation("IssueReturnedBy")
  finesWaived   Fine[]         @relation("FineWaivedBy")

  @@unique([orgId, email])
  @@unique([orgId, phone])
  @@index([orgId])
}

model Member {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @db.Uuid
  homeBranchId     String?      @db.Uuid
  code             String
  memberType       MemberType   @default(STUDENT)
  firstName        String
  lastName         String
  phone            String?
  email            String?
  photoUrl         String?
  address          String?
  customFields     Json         @default("{}")
  status           MemberStatus @default(PENDING)
  joinedAt         DateTime     @default(now())
  /// null = no expiry. Membership expiry is computed from this at read time,
  /// never stored as a status — see the no-scheduler rule in the spec (§6.3).
  membershipEndsAt DateTime?
  /// Holds the Sckools Student.id / Teacher.id when the services merge.
  /// Present from the first migration so the merge needs no schema change.
  externalRef      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  org        LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  homeBranch Branch?    @relation(fields: [homeBranchId], references: [id], onDelete: SetNull)
  login      LibUser?
  issues     Issue[]
  holds      Hold[]
  fines      Fine[]

  @@unique([orgId, code])
  @@index([orgId, status])
  @@index([orgId, externalRef])
}

/// Hash-keyed and single-use. Deliberately has no RLS policy — see the
/// allow-list in the RLS coverage audit (Task 3).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  /// Set when this token was rotated normally. Within the service's grace
  /// window of this timestamp, a replay of this (now-revoked) token is
  /// treated as a duplicate request — a client retry racing the winner of a
  /// concurrent rotation — rather than theft, and a FRESH child is minted
  /// and returned rather than revoking the family.
  ///
  /// Deliberately holds no reference to what this token was replaced
  /// BY: an earlier revision of this column (`replacedByToken`) stored the
  /// raw replacement token itself, so that a grace-window replay could hand
  /// back the exact same child. Review found that traded away the one
  /// property hashing `tokenHash` exists to provide — a database-read
  /// compromise (backup leak, injection, insider) would yield a directly
  /// usable bearer token, live for the row's full multi-day TTL, for every
  /// ordinary (non-replayed) rotation, not just the rare theft case. Minting
  /// a fresh child per grace-window replay instead keeps this table
  /// hash-only again: nothing derived from a live secret is ever persisted
  /// here in reversible form.
  supersededAt DateTime?

  /// Count of grace-window replays of THIS parent that have already been
  /// allowed through (minted a fresh child). Incremented atomically —
  /// `UPDATE ... SET graceReplayCount = graceReplayCount + 1 WHERE id = ?
  /// AND graceReplayCount < cap` — by the same conditional-update pattern
  /// `markUsed` already uses, so concurrent replays cannot all read the
  /// same pre-increment value and all pass.
  ///
  /// This is not a rate limit bolted on after the fact — it IS the theft
  /// signal, on the same footing as the time window: a genuine double-tap
  /// or duplicate tab produces one or two replays, a mobile retry chain
  /// maybe three. Someone firing far more than that inside the same few
  /// seconds isn't retrying, they're working the window — and the correct
  /// response to that is exactly the theft response (family revoke), not a
  /// 429. See `RefreshService.REFRESH_GRACE_REPLAY_CAP` for the chosen cap
  /// and the reasoning above stated in full.
  graceReplayCount Int @default(0)

  user LibUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  at          DateTime @default(now())

  @@index([orgId, at])
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  key            String
  endpoint       String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@unique([orgId, key])
  @@index([createdAt])
}

enum AuthorRole {
  AUTHOR
  EDITOR
  TRANSLATOR
}

enum CopyCondition {
  NEW
  GOOD
  FAIR
  POOR
}

enum CopyStatus {
  AVAILABLE
  ON_LOAN
  ON_HOLD_SHELF
  IN_TRANSIT
  LOST
  DAMAGED
  WITHDRAWN
}

model Title {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  isbn13        String?
  isbn10        String?
  title         String
  subtitle      String?
  publisher     String?
  publishedYear Int?
  edition       String?
  language      String   @default("en")
  callNumber    String?
  coverUrl      String?
  description   String?
  pageCount     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Generated column, added by hand in the catalogue migration (Prisma
  /// cannot express `GENERATED ALWAYS AS (...) STORED`). `Unsupported` here
  /// only tells Prisma to tolerate the column's existence in introspection;
  /// no application code writes to it.
  searchVector Unsupported("tsvector")?

  org        LibraryOrg      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authors    TitleAuthor[]
  categories TitleCategory[]
  copies     Copy[]
  holds      Hold[]

  @@index([orgId])
  @@index([orgId, callNumber])
}

model Author {
  id       String @id @default(uuid()) @db.Uuid
  orgId    String @db.Uuid
  name     String
  sortName String

  org    LibraryOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  titles TitleAuthor[]

  @@unique([orgId, sortName])
  @@index([orgId])
}

/// Carries no orgId of its own — reachable only through Title (RLS-scoped)
/// and Author (RLS-scoped), whose foreign keys both cascade from here. See
/// the org_isolation policy comment in the catalogue_rls migration and the
/// RLS_ALLOW_LIST comment in rls-audit.ts for why this is allow-listed
/// rather than unprotected.
model TitleAuthor {
  titleId  String     @db.Uuid
  authorId String     @db.Uuid
  role     AuthorRole @default(AUTHOR)

  title  Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([titleId, authorId, role])
  @@index([authorId])
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  orgId    String  @db.Uuid
  name     String
  parentId String? @db.Uuid

  org      LibraryOrg      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]      @relation("CategoryTree")
  titles   TitleCategory[]

  @@unique([orgId, name])
  @@index([orgId])
}

/// Carries no orgId of its own — see TitleAuthor's comment above; same
/// indirection through Title and Category.
model TitleCategory {
  titleId    String @db.Uuid
  categoryId String @db.Uuid

  title    Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([titleId, categoryId])
  @@index([categoryId])
}

model Copy {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @db.Uuid
  titleId         String        @db.Uuid
  branchId        String        @db.Uuid
  /// The number written inside the front cover, by hand, permanently. It is
  /// unique per PHYSICAL COPY and is the only identifier this service uses —
  /// there is deliberately no barcode, because a school should not have to buy
  /// and maintain scanner hardware to lend a book. Sequential per library, which
  /// is what lets stock verification accept a shelf as a RANGE.
  ///
  /// Never reused. A copy written off as lost keeps its number for good and a
  /// replacement is entered under the next one, so the register reads as a
  /// history rather than a stock list — which is what an auditor checks.
  accessionNumber String
  shelf           String?
  condition       CopyCondition @default(GOOD)
  acquiredAt      DateTime?
  acquisitionCost Decimal?      @db.Decimal(10, 2)
  status          CopyStatus    @default(AVAILABLE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  org    LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: deleting a title that still has physical copies
  /// is a data-loss bug and must fail loudly, not silently vanish stock.
  title  Title      @relation(fields: [titleId], references: [id], onDelete: Restrict)
  /// Restrict, not Cascade: same reasoning for a branch that still holds
  /// stock.
  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  issues Issue[]
  holds  Hold[]     @relation("HoldReadyCopy")

  @@unique([orgId, accessionNumber])
  @@index([titleId, status])
  @@index([orgId, branchId, status])
}

enum IssueStatus {
  ACTIVE
  RETURNED
  LOST
}

/// Includes `EXPIRED` — restored after review correction (batch report,
/// review finding 2). Trap 7 (docs/superpowers/LIBRARY-TRAPS.md) forbids a
/// status only a SCHEDULER can flip, because a missed cron then corrupts
/// state. `EXPIRED` here is not that: it is set by the next user-triggered
/// action that touches this title's holds (the sweep that runs when the
/// next copy is returned, promoting/lapsing the queue), never by a clock in
/// the absence of any request. `expiresAt` stays the source of truth for
/// "has this hold lapsed yet" before that sweep runs — a hold can be
/// PAST expiresAt and still show status READY until something touches it.
/// Storing the terminal outcome distinctly from CANCELLED matters for
/// reporting: without it, "how many holds went unclaimed" (EXPIRED) is
/// indistinguishable from "how many holds a member cancelled" (CANCELLED)
/// once both collapse into the same value. See
/// packages/library-db/src/schema-shape.spec.ts's `FORBIDDEN_VALUE_EXCEPTIONS`
/// for the reviewable, by-name exception this value is allow-listed under.
enum HoldStatus {
  PENDING
  READY
  COLLECTED
  EXPIRED
  CANCELLED
}

enum FineKind {
  OVERDUE
  DAMAGE
  LOST
  OTHER
}

enum FineStatus {
  OPEN
  PAID
  WAIVED
  PARTIAL
}

/// Keyed on (orgId, memberType) — MemberType stays a fixed enum (see
/// OrgTheme.memberTypeLabels) precisely so a policy can be looked up by it
/// without a join. Field names mirror apps/library-api's pure policy engine
/// (`modules/circulation/internal/policy.ts`'s `Policy` interface) so a
/// future Prisma-backed caller needs no translation layer.
model CirculationPolicy {
  id                 String     @id @default(uuid()) @db.Uuid
  orgId              String     @db.Uuid
  /// null = org default, used when no row exists for the caller's specific
  /// branch. `circulation/internal/policy-loader.ts`'s `loadPolicy` always
  /// tries the branch-specific row first, falling back to this one.
  ///
  /// True uniqueness — "at most one branch-specific row per (orgId,
  /// branchId, memberType), AND at most one org-default row per (orgId,
  /// memberType)" — is NOT expressible as a single Prisma `@@unique` here:
  /// Postgres unique indexes treat NULL as distinct from NULL, so a naive
  /// `@@unique([orgId, branchId, memberType])` would silently permit two
  /// org-default (branchId NULL) rows to coexist for the same memberType —
  /// the same NULL-is-not-equal-to-NULL gotcha this project already works
  /// around for RLS (NULLIF, LIBRARY-TRAPS.md #1). Enforced instead by two
  /// partial unique indexes in the branch-scope migration — the same
  /// technique `loan_one_active_per_copy` already uses for a different
  /// NULL-bearing column (see that migration's own comment).
  branchId           String?    @db.Uuid
  memberType         MemberType
  maxBooks           Int
  issueDays          Int
  renewLimit         Int
  renewDays          Int
  finePerDay         Decimal    @db.Decimal(10, 2)
  /// Days past dueAt with zero fine before billing starts.
  graceDays          Int
  /// null = uncapped.
  maxFine            Decimal?   @db.Decimal(10, 2)
  maxHolds           Int
  holdShelfDays      Int
  /// null = no outstanding-fine gate on new issues.
  maxOutstandingFine Decimal?   @db.Decimal(10, 2)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Restrict, not SetNull: a branch deletion that silently demoted a
  /// branch-specific policy to an org default would also risk colliding with
  /// the partial unique index enforcing "one org default per memberType" —
  /// confusing either way. A branch with a configured policy must not vanish
  /// out from under it (same reasoning as Copy.branchId's Restrict).
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([orgId, branchId, memberType])
  @@index([orgId])
}

model Issue {
  id               String     @id @default(uuid()) @db.Uuid
  orgId            String     @db.Uuid
  copyId           String     @db.Uuid
  /// Denormalized from `Copy.branchId` at issue time (LoansService.issue) so
  /// "which branch is this loan at" is answerable directly, without a join
  /// through Copy, on every branch-scoped read (BranchScopeGuard,
  /// listOverdue, dayReport). NOT NULL: unlike Hold.branchId, an Issue always
  /// has a copy from the moment it exists, so there is no "not yet known"
  /// state to represent.
  branchId         String     @db.Uuid
  memberId         String     @db.Uuid
  issuedAt         DateTime   @default(now())
  dueAt            DateTime
  /// null while the issue is open. LATE is never stored — see IssueStatus.
  returnedAt       DateTime?
  renewCount       Int        @default(0)
  issuedByUserId   String?    @db.Uuid
  returnedByUserId String?    @db.Uuid
  status           IssueStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  org        LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Restrict: a copy with loan history must not vanish out from under it.
  copy       Copy       @relation(fields: [copyId], references: [id], onDelete: Restrict)
  /// Restrict, same reasoning as `copy` above — a branch with loan history
  /// must not vanish out from under it.
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  issuedBy   LibUser?   @relation("IssueIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  returnedBy LibUser?   @relation("IssueReturnedBy", fields: [returnedByUserId], references: [id], onDelete: SetNull)
  fines      Fine[]

  @@index([orgId])
  @@index([orgId, branchId])
}

/// Keyed on titleId, not copyId: a member holds a place in line for a TITLE
/// (any available copy will do), and only gets tied to a specific copy
/// (readyCopyId) once one is pulled for them.
model Hold {
  id            String     @id @default(uuid()) @db.Uuid
  orgId         String     @db.Uuid
  titleId       String     @db.Uuid
  /// Set only when this hold is promoted — the branch of the copy pulled for
  /// it (mirrors readyCopyId/readyAt, set together in
  /// LoansService.promoteOrRelease). A still-PENDING hold has no branch: it
  /// is a place in line for a Title, fillable by any branch's copy, so this
  /// stays null until promotion — unlike Issue.branchId, which is set at
  /// issue and therefore NOT NULL.
  branchId      String?    @db.Uuid
  memberId      String     @db.Uuid
  /// Lower = earlier in the queue.
  queuePosition Int
  status        HoldStatus @default(PENDING)
  readyCopyId   String?    @db.Uuid
  readyAt       DateTime?
  /// Meaningful ONLY when status is READY: the hold-shelf deadline, set at
  /// promotion time to `holdShelfExpiry(policy, promotedAt)`
  /// (apps/library-api's policy.ts) — computed from the promoted member's
  /// own CirculationPolicy, not the returning member's. Past this deadline
  /// (still READY in the stored row), the hold reads as EXPIRED at query
  /// time via `policy.ts`'s `holdState` — never written by a scheduler
  /// (trap 7): the terminal EXPIRED row write happens only inside the next
  /// RETURN for this title's `promoteOrRelease` sweep (loans.service.ts), a
  /// user-triggered action, never a timer.
  ///
  /// A PENDING hold has no real deadline yet (nothing has been promoted for
  /// it, so there is nothing to expire), but this column is NOT NULL — no
  /// natural "no deadline" value exists for a DateTime, and adding a
  /// nullable column (or a queue-timeout feature this phase doesn't have)
  /// for a value nothing reads is not worth the complexity. Task 8 already
  /// established the convention informally (see its e2e's `FAR_FUTURE`
  /// fixture); Task 9 formalizes it here and in code:
  /// `holds.service.ts`'s `PENDING_HOLD_SENTINEL_YEARS`/
  /// `pendingHoldSentinel()` is the ONE place that value is produced, kept
  /// far enough out it can never be mistaken for "expiring soon" by a naive
  /// read, and `holdState` never reinterprets a PENDING hold by `expiresAt`
  /// regardless of its value — only READY ever is.
  expiresAt     DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  org       LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title     Title      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  readyCopy Copy?      @relation("HoldReadyCopy", fields: [readyCopyId], references: [id], onDelete: SetNull)
  /// Restrict, same reasoning as Issue.branch — a branch a hold was ever
  /// promoted onto must not vanish out from under that history.
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([orgId, branchId])
}

model Fine {
  id             String     @id @default(uuid()) @db.Uuid
  orgId          String     @db.Uuid
  memberId       String     @db.Uuid
  issueId        String?    @db.Uuid
  kind           FineKind
  status         FineStatus @default(OPEN)
  amount         Decimal    @db.Decimal(10, 2)
  paidAmount     Decimal    @default(0) @db.Decimal(10, 2)
  reason         String?
  /// Task 10: set together, only when `status` becomes WAIVED. `waivedAmount`
  /// is the amount actually forgiven (may be less than `amount -
  /// paidAmount` for a partial waiver — see fines.service.ts's `waive`);
  /// never re-derived from `amount`/`paidAmount` after the fact, since
  /// those can still be read independently for "what was originally owed"
  /// reporting.
  waivedByUserId String?    @db.Uuid
  waivedAmount   Decimal?   @db.Decimal(10, 2)
  waivedReason   String?
  waivedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  org      LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade (fixed per review finding 4): loanId is nullable
  /// and kind includes DAMAGE/OTHER, so a member can carry an OPEN fine with
  /// no Issue behind it at all. Cascade would let deleting that member
  /// silently destroy a real financial record — money genuinely owed —
  /// exactly the "fails quietly" failure mode Copy.title's Restrict already
  /// exists to prevent for physical stock.
  member   Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  issue    Issue?     @relation(fields: [issueId], references: [id], onDelete: SetNull)
  /// SetNull, not Restrict: the waiving LibUser leaving/being deleted must
  /// not block user deletion, and losing "who waived it" is acceptable —
  /// the money itself (waivedAmount/waivedReason) stays on the row either way.
  waivedBy LibUser?   @relation("FineWaivedBy", fields: [waivedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId])
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  INAPP
}

/// The durable record of an outbound notification. Task 8's return flow
/// writes a `HOLD_READY` row here on hold promotion — nothing drains this
/// table until Phase 4's outbox drain cron exists (see the no-scheduler rule,
/// §6.3 of the design doc: a missed drain delays a message, it can never
/// corrupt an Issue/Hold/Fine, because none of THEIR state depends on this
/// table ever being read). `templateKey` is a plain string, not an enum,
/// because `NotificationTemplate` (the model that would own that
/// enumeration) is itself a Phase 4 table — pinning the key values into this
/// schema before that model exists would be premature.
model NotificationOutbox {
  id           String              @id @default(uuid()) @db.Uuid
  orgId        String              @db.Uuid
  channel      NotificationChannel
  templateKey  String
  /// Recipient identifier — a memberId, phone, or email depending on
  /// `channel`; Phase 4's channel adapters decide how to resolve it.
  to           String
  payload      Json                @default("{}")
  scheduledFor DateTime            @default(now())
  sentAt       DateTime?
  attempts     Int                 @default(0)
  lastError    String?
  providerRef  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  org LibraryOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// A partial index on `scheduledFor WHERE sentAt IS NULL` — the actual hot
  /// read path for a future drain worker (Phase 4) — is added by hand in the
  /// migration, not declared here: Prisma's schema DSL cannot express a
  /// partial index. Mirrors the `loan_one_active_per_copy` / `hold_title_queue`
  /// partial indexes already hand-added in the circulation migration, which
  /// are likewise absent from their models' `@@index` lists above.

  @@index([orgId, sentAt])
}
