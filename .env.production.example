# ─────────────────────────────────────────────────────────────────────────────
# SkoolOS — production environment (Vercel)
#
# Set these in each Vercel project's Environment Variables (Production scope).
# The API project needs the server-side vars; the WEB project needs only the
# NEXT_PUBLIC_* / API URL / PLATFORM_HOST vars. See DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Hosts (drive multi-tenant routing) ──────────────────────────────────────
# The apex you own on Vercel. Schools live at <slug>.PLATFORM_HOST automatically.
PLATFORM_HOST=skoolos.app
PLATFORM_OWNER_HOST=owner.skoolos.app

# ── API URLs (WEB project) ──────────────────────────────────────────────────
# Public API origin the browser calls, and the server-to-server base the Next
# server uses. Point both at the deployed API project's domain.
NEXT_PUBLIC_API_URL=https://api.skoolos.app
API_INTERNAL_URL=https://api.skoolos.app

# Extra browser origins allowed by CORS (custom school domains), comma-separated.
# *.skoolos.app + owner host are allowed automatically.
CORS_EXTRA_ORIGINS=

# ── Database (API project) — Neon (or any Postgres supporting custom roles) ──
# DATABASE_URL: superuser/owner role — used for `prisma migrate deploy` only.
# DATABASE_URL_APP: the RLS-ENFORCED role (skoolos_app, NOT superuser).
# DATABASE_URL_PLATFORM: the BYPASSRLS role (skoolos_platform).
# Use the POOLED connection string (PgBouncer/Neon pooler) for the two runtime
# URLs — serverless opens many connections. See DEPLOY.md § Database.
#
# The two RUNTIME urls must carry `pgbouncer=true` and an explicit
# `connection_limit`. Neither is optional:
#
#   pgbouncer=true    Neon's pooler runs in transaction mode and discards
#                     prepared statements between transactions. Without the
#                     flag Prisma still tries to reuse them, which surfaces as
#                     intermittent `prepared statement "s0" already exists`
#                     under concurrency.
#
#   connection_limit  Prisma defaults to `physical_cpus * 2 + 1` (17 on a
#                     typical box). That is sized for a long-running server and
#                     wrong for serverless, where TOTAL connections are
#                     instances x limit and a burst multiplies it without
#                     warning.
#
#                     Measured at 100 VUs against 200 schools / 9M attendance
#                     rows (scripts/loadtest), per instance:
#                       limit  3 ->   660 req/s, p95 208ms, 150 instances to 450 conns
#                       limit  5 ->   859 req/s, p95 167ms,  90 instances
#                       limit  8 ->  1009 req/s, p95 142ms,  56 instances
#                       limit 17 ->  1167 req/s, p95 127ms,  26 instances
#
#                     5 is chosen: 74% of peak per-instance throughput, and it
#                     takes 90 concurrent instances to reach a Neon 1 CU
#                     ceiling of 450. The default's 26 is uncomfortably close
#                     for a morning burst. Raise it only alongside a bigger
#                     Neon compute, and re-run scripts/loadtest to confirm.
#
# DATABASE_URL (migrations only) deliberately has NEITHER, and should point at
# the DIRECT host, not the pooler: `prisma migrate deploy` needs an unpooled
# session to take advisory locks.
DATABASE_URL=postgresql://OWNER:PW@ep-xxx.neon.tech/skoolos?sslmode=require
DATABASE_URL_APP=postgresql://skoolos_app:PW@ep-xxx.pooler.neon.tech/skoolos?sslmode=require&pgbouncer=true&connection_limit=5
DATABASE_URL_PLATFORM=postgresql://skoolos_platform:PW@ep-xxx.pooler.neon.tech/skoolos?sslmode=require&pgbouncer=true&connection_limit=5

# ── Redis (API project) — Upstash ───────────────────────────────────────────
REDIS_URL=rediss://default:PW@xxx.upstash.io:6379

# ── Object storage (API project) — Vercel Blob / S3-compatible ──────────────
S3_ENDPOINT=https://xxx.public.blob.vercel-storage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=skoolos
S3_REGION=us-east-1

# ── Email (API project) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_FROM=no-reply@skoolos.app

# ── JWT secrets (API project) — generate 4 distinct 32+ char secrets ────────
# e.g. `openssl rand -base64 32`
JWT_SCHOOL_ACCESS_SECRET=
JWT_SCHOOL_REFRESH_SECRET=
JWT_PLATFORM_ACCESS_SECRET=
JWT_PLATFORM_REFRESH_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# ENABLE_SWAGGER=false            # expose /api/docs in prod (default off)
# JWT_ACCESS_TTL=900
# JWT_REFRESH_TTL=2592000
