# ─────────────────────────────────────────────────────────────────────────────
# SkoolOS — production environment (Vercel)
#
# Set these in each Vercel project's Environment Variables (Production scope).
# The API project needs the server-side vars; the WEB project needs only the
# NEXT_PUBLIC_* / API URL / PLATFORM_HOST vars. See DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Hosts (drive multi-tenant routing) ──────────────────────────────────────
# The apex you own on Vercel. Schools live at <slug>.PLATFORM_HOST automatically.
PLATFORM_HOST=skoolos.app
PLATFORM_OWNER_HOST=owner.skoolos.app

# ── API URLs (WEB project) ──────────────────────────────────────────────────
# Public API origin the browser calls, and the server-to-server base the Next
# server uses. Point both at the deployed API project's domain.
NEXT_PUBLIC_API_URL=https://api.skoolos.app
API_INTERNAL_URL=https://api.skoolos.app

# Extra browser origins allowed by CORS (custom school domains), comma-separated.
# *.skoolos.app + owner host are allowed automatically.
CORS_EXTRA_ORIGINS=

# ── Database (API project) — SUPABASE ───────────────────────────────────────
# AUTHORITATIVE SETUP: docs/DATABASE.md. This file is a template; that doc is
# the process. Both connection strings come from
# Supabase -> Project Settings -> Database -> Connection string.
#
#   DATABASE_URL      TRANSACTION pooler, port 6543, with ?pgbouncer=true
#   DIRECT_URL        SESSION pooler,     port 5432 (Prisma needs a non-pooled
#                     session for migrations' advisory locks)
#
# DATABASE_URL_APP is the RLS-ENFORCED role (skoolos_app, NOT superuser).
# DATABASE_URL_PLATFORM is the BYPASSRLS role (skoolos_platform).
#
# pgbouncer=true is REQUIRED on the transaction pooler: it runs in transaction
# mode and discards prepared statements between transactions. Without the flag
# Prisma still tries to reuse them, surfacing as intermittent
# `prepared statement "s0" already exists` under concurrency.
#
# connection_limit — Prisma defaults to physical_cpus * 2 + 1 (17 on a typical
# box), sized for a long-running server. On serverless the number that matters
# is instances x limit, because Vercel scales on CONCURRENCY, not throughput.
#
# Measured at 100 VUs against 200 schools / 9M attendance rows
# (scripts/loadtest), per instance:
#
#     limit  1  ->   285 req/s, p95 505ms
#     limit  2  ->   457 req/s, p95 296ms
#     limit  5  ->   755 req/s, p95 190ms
#     limit  8  ->  1009 req/s, p95 142ms
#     limit 17  ->  1167 req/s, p95 127ms
#
# PRODUCTION'S ACTUAL VALUE IS UNVERIFIED. The only reference in the repo is
# docs/PRODUCTION.md:148, which is stale — it also says "Neon-style" and puts
# the API on Railway. docs/DATABASE.md (authoritative) specifies ?pgbouncer=true
# and says nothing about a limit. Read the live Vercel env before changing this.
#
# The 1 below mirrors that stale reference and Supabase's conservative
# serverless guidance. If production really is 1, it gives up roughly 4x
# throughput and 4x p95 versus 5 — but raising it trades against Supavisor pool
# capacity, which this bench cannot measure. Treat 5 as a target to move toward
# WITH pooler metrics in view (Phase 4 dashboard), never a value to paste in blind.
DATABASE_URL=postgresql://postgres.PROJECT:PW@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.PROJECT:PW@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL_APP=postgresql://skoolos_app:PW@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL_PLATFORM=postgresql://skoolos_platform:PW@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ── Redis (API project) — Upstash ───────────────────────────────────────────
REDIS_URL=rediss://default:PW@xxx.upstash.io:6379

# ── Object storage (API project) — Vercel Blob / S3-compatible ──────────────
S3_ENDPOINT=https://xxx.public.blob.vercel-storage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=skoolos
S3_REGION=us-east-1

# ── Email (API project) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_FROM=no-reply@skoolos.app

# ── JWT secrets (API project) — generate 4 distinct 32+ char secrets ────────
# e.g. `openssl rand -base64 32`
JWT_SCHOOL_ACCESS_SECRET=
JWT_SCHOOL_REFRESH_SECRET=
JWT_PLATFORM_ACCESS_SECRET=
JWT_PLATFORM_REFRESH_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# ENABLE_SWAGGER=false            # expose /api/docs in prod (default off)
# JWT_ACCESS_TTL=900
# JWT_REFRESH_TTL=2592000
