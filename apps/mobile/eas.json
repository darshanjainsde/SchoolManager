{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "internal": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.test.sckools.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "NPM_CONFIG_NODE_LINKER": "hoisted"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sckools.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "NPM_CONFIG_NODE_LINKER": "hoisted"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sckools.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "NPM_CONFIG_NODE_LINKER": "hoisted"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
