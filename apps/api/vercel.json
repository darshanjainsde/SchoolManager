{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile=false && pnpm --filter @skoolos/db generate",
  "buildCommand": "npx --yes @vercel/ncc build server.ts -o .ncc --quiet",
  "outputDirectory": ".ncc",
  "functions": {
    ".ncc/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/.ncc/index.js"
    }
  ]
}
