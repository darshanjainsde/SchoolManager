{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "installCommand": "cd ../.. && NODE_ENV=development pnpm install --frozen-lockfile=false && pnpm --filter @skoolos/db generate && pnpm --filter @library/db generate && node apps/api/scripts/deref-pnpm-symlinks.mjs",
  "buildCommand": "pnpm run bundle",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{,generated/client/,.prisma/client/,apps/api/}libquery_engine-rhel-openssl-3.0.x.so.node"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/exam-reminders",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/internal/cron/notification-outbox",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/internal/cron/library-reminders",
      "schedule": "30 1 * * *"
    }
  ]
}
