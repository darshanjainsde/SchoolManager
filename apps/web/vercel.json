{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "bom1"
  ],
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile=false",
  "buildCommand": "cd ../.. && pnpm --filter @skoolos/db generate && pnpm --filter @skoolos/web build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sckools.com"
        }
      ],
      "destination": "https://sckools.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.test.sckools.com"
        }
      ],
      "destination": "https://test.sckools.com/:path*",
      "permanent": true
    }
  ]
}
