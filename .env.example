# ---- App ----
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Postgres ----
POSTGRES_USER=skoolos
POSTGRES_PASSWORD=skoolos
POSTGRES_DB=skoolos
POSTGRES_PORT=5432
# Superuser — only used for migrations + creating the test DB.
DATABASE_URL=postgresql://skoolos:skoolos@localhost:5432/skoolos?schema=public
# Tenant runtime — RLS-bound, no superuser privileges.
DATABASE_URL_APP=postgresql://skoolos_app:skoolos_app_pw@localhost:5432/skoolos?schema=public
# Platform runtime — BYPASSRLS, used only by the platform-owner code path.
DATABASE_URL_PLATFORM=postgresql://skoolos_platform:skoolos_platform_pw@localhost:5432/skoolos?schema=public
# Test DB — created on demand by jest globalSetup.
DATABASE_URL_TEST=postgresql://skoolos:skoolos@localhost:5432/skoolos_test?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=skoolosminio
S3_SECRET_KEY=skoolosminio
S3_BUCKET=skoolos
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---- MailHog (SMTP) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="SkoolOS <no-reply@skoolos.local>"

# ---- Auth ----
# School-audience secrets (signs tokens for users at <slug>.localhost).
JWT_SCHOOL_ACCESS_SECRET=change-me-school-access-secret
JWT_SCHOOL_REFRESH_SECRET=change-me-school-refresh-secret
# Platform-audience secrets (signs tokens for the platform owner at owner.localhost).
JWT_PLATFORM_ACCESS_SECRET=change-me-platform-access-secret
JWT_PLATFORM_REFRESH_SECRET=change-me-platform-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Failed-login lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=900
# Optional comma-separated IP allowlist for the platform host. Empty = allow all.
PLATFORM_IP_ALLOWLIST=

# ---- Tenant routing (used in Phase 1+) ----
PLATFORM_HOST=localhost
PLATFORM_OWNER_HOST=owner.localhost
INGRESS_CNAME_TARGET=ingress.skoolos.app
INGRESS_A_RECORD=127.0.0.1
