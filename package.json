{
  "name": "skoolos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundary": "node scripts/check-tsconfig-scope.mjs && depcruise apps/api/src --config .dependency-cruiser.cjs",
    "preflight": "bash scripts/preflight.sh",
    "preflight:library": "bash scripts/preflight-library.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @skoolos/db generate",
    "db:migrate": "pnpm --filter @skoolos/db migrate:dev",
    "db:seed": "pnpm --filter @skoolos/db seed",
    "library:migrate": "pnpm --filter @library/db migrate:deploy",
    "library:seed": "pnpm --filter @library/db seed",
    "dash": "node tools/test-dashboard/server.mjs",
    "dispatch:log": "node scripts/dispatch-metrics.mjs log",
    "dispatch:report": "node scripts/dispatch-metrics.mjs report",
    "dispatch:ui": "node scripts/dispatch-ui.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "prisma",
      "@prisma/client"
    ],
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "dependency-cruiser": "^16.3.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.6",
    "typescript": "^5.4.5"
  }
}
